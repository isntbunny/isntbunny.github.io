---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings);
---

<details>
	<summary>Table of Contents</summary>
	<nav>
		<ol>
			{toc.map((heading) => <TOCHeading heading={heading} />)}
		</ol>
	</nav>
</details>

<style>
  /* 目录容器 - 粘性侧边栏 */
  .toc-container {
    position: sticky;
    top: 3rem;  /* 相当于 top-12 */
    order: 2;
    margin-right: -8rem;  /* 相当于 -me-32，负边距拉出去 */
    flex-basis: 16rem;    /* 相当于 basis-64，256px */
  }

  /* 在大屏幕上调整 */
  @media (min-width: 1024px) {
    .toc-container {
      position: sticky;
      top: 3rem;
      order: 2;
      margin-right: -8rem;
      flex-basis: 16rem;
    }
  }

  /* 标题行样式 */
  .toc-summary {
    cursor: pointer;
    font-size: 1.125rem;  /* text-lg */
    font-weight: 500;
    color: var(--accent-color, #3b82f6);
  }

  /* 注意：浏览器默认的 summary 三角标记比较难直接改颜色，
     如果想完全控制，可以用 list-style: none 隐藏默认三角，
     然后用伪元素自己做三角。这里给一个简单方案：隐藏默认三角，用 content 模拟 */

  /* 隐藏默认三角标记 */
  .toc-summary {
    list-style: none;
  }
  .toc-summary::-webkit-details-marker {
    display: none;
  }

  /* 自定义三角标记（用伪元素） */
  .toc-summary::before {
    content: "▶";
    display: inline-block;
    font-size: 0.875rem;
    margin-right: 0.5rem;
    transition: transform 0.2s;
  }

  /* 展开时三角旋转 */
  details[open] .toc-summary::before {
    transform: rotate(90deg);
  }

  /* 导航容器 */
  .toc-nav {
    margin-left: 1rem;   /* ms-4 */
  }

  @media (min-width: 1024px) {
    .toc-nav {
      width: 100%;
    }
  }

  /* 列表样式 */
  .toc-list {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  /* 可选：给列表项加一些间距 */
  .toc-list li {
    margin: 0.25rem 0;
  }
</style>