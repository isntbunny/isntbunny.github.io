---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";
import { generateToc } from "@/utils/generateToc";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const toc = generateToc(headings);
---

<details>
	<summary>Table of Contents</summary>
	<nav>
		<ol>
			{toc.map((heading) => <TOCHeading heading={heading} />)}
		</ol>
	</nav>
</details>

<style>
  .toc-container {
      position: fixed;
      left: 0 !important;
      top: 0 !important;
      transform: none !important;
      width: 100%;
      max-height: none;
      height: auto;
      border-radius: 0;
      padding: 0.5rem 1rem;?
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
      border: none;
      border-bottom: 1px solid rgba(229, 231, 235, 0.3);
      background: rgba(255, 255, 255, 0.98);
      overflow-y: visible;
      transition: none;
  }




  /* 自定义三角标记（用伪元素） */
  .toc-summary::before {
    content: "▶";
    display: inline-block;
    font-size: 0.875rem;
    margin-right: 0.5rem;
    transition: transform 0.2s;
  }

  /* 展开时三角旋转 */
  details[open] .toc-summary::before {
    transform: rotate(90deg);
  }

  /* 导航容器 */
  .toc-nav {
      position: fixed;
      left: 0 !important;
      top: 0 !important;
      transform: none !important;
      width: 100%;
      max-height: none;
      height: auto;
      border-radius: 0;
      padding: 0.5rem 1rem;?
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
      border: none;
      border-bottom: 1px solid rgba(229, 231, 235, 0.3);
      background: rgba(255, 255, 255, 0.98);
      overflow-y: visible;
      transition: none;
  }

  /* 列表样式 */
  .toc-list {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }
</style>