---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
	content: CollectionEntry<"post">;
	readingTime: string;
	wordCount: number;
}

const { content, readingTime, wordCount } = Astro.props;
const { data } = content;
---

<div class="masthead-wrapper">
	{
		data.coverImage && (
			<div class="cover-image">
				<Image
					alt={data.coverImage.alt}
					layout="constrained"
					width={748}
					height={420}
					priority
					src={data.coverImage.src}
				/>
			</div>
		)
	}
	
	<div class="header-content">
		{data.draft ? <span class="draft-badge">📝 Draft</span> : null}
		
		<h1 class="post-title">{data.title}</h1>
		
		<div class="meta-grid">
			<div class="meta-item">
				<span class="meta-label">Published</span>
				<span class="meta-value">
					<FormattedDate date={data.publishDate} />
				</span>
			</div>
			
			<div class="meta-item">
				<span class="meta-label">Reading</span>
				<span class="meta-value">{readingTime}</span>
			</div>
			
			<div class="meta-item">
				<span class="meta-label">Words</span>
				<span class="meta-value">{wordCount ? `${wordCount}字` : '--'}</span>
			</div>
		</div>
		
		{
			data.updatedDate && (
				<div class="updated-wrapper">
					<span class="updated-badge">
						🔄 Updated:
						<FormattedDate class="updated-date" date={data.updatedDate} />
					</span>
				</div>
			)
		}
	</div>
</div>

<style>
	.cover-image {
		margin-bottom: 1.5rem;
		aspect-ratio: 16 / 9;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--card-shadow);
	}

	.header-content {
		background: var(--card-bg);
		padding: 1.5rem 2rem;
		border-radius: 12px;
		box-shadow: var(--card-shadow);
		border: 1px solid var(--glass-border);
		backdrop-filter: blur(4px);
	}

	.draft-badge {
		display: inline-block;
		margin-bottom: 0.5rem;
		padding: 0.15rem 0.8rem;
		background: #fef2f2;
		color: #dc2626;
		font-size: 0.75rem;
		font-weight: 600;
		border-radius: 16px;
		border: 1px solid #fecaca;
	}

	.post-title {
		font-size: 1.8rem;
		margin-bottom: 1rem;
	}

	@media (min-width: 640px) {
		.post-title {
			font-size: 2.2rem;
		}
	}

	.meta-grid {
		display: flex;
		justify-content: center;
		gap: 2rem;
		padding: 0.75rem 0;
		border-top: 1px solid var(--glass-border);
		border-bottom: 1px solid var(--glass-border);
		margin-bottom: 0.75rem;
	}

	.meta-item {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
	}

	.meta-label {
		font-size: 0.65rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
	}

	.meta-value {
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--text-main);
	}

	.updated-wrapper {
		display: flex;
		justify-content: center;
	}

	.updated-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.2rem 1rem;
		border-radius: 16px;
		background: var(--angel-blue-pale);
		color: var(--text-muted);
		font-size: 0.7rem;
		font-weight: 500;
		border: 1px solid var(--glass-border);
	}

	.updated-date {
		font-weight: 600;
		color: var(--text-main);
	}

	@media (max-width: 640px) {
		.header-content {
			padding: 1rem 1.25rem;
		}

		.post-title {
			font-size: 1.4rem;
		}

		.meta-grid {
			flex-wrap: wrap;
			gap: 0.5rem 1.5rem;
			padding: 0.5rem 0;
		}

		.meta-item {
			flex-direction: column;
			align-items: center;
			gap: 0.1rem;
		}
	}

	@media (max-width: 400px) {
		.header-content {
			padding: 0.75rem 1rem;
		}

		.post-title {
			font-size: 1.2rem;
		}

		.meta-grid {
			flex-direction: column;
			gap: 0.3rem;
			align-items: center;
		}

		.meta-item {
			flex-direction: row;
			gap: 0.4rem;
		}
	}
</style>