---
import { siteSettings } from "@/config/site-settings";
---

<div class="mt-12">
	<h2 class="mb-6 text-2xl font-semibold">点赞与评论</h2>
	<div id="twikoo-comments"></div>
</div>

<script define:vars={{ twikooEnvId: siteSettings.comments.twikoo.envId, twikooScriptSrc: siteSettings.comments.twikoo.scriptSrc }}>
	const initTwikooComments = () => {
		if (document.getElementById("twikoo-comments")?.childElementCount) return;
				const doInit = () => {
			// @ts-expect-error twikoo runtime inject
			window.twikoo?.init?.({
				envId: twikooEnvId,
				el: "#twikoo-comments",
				path: window.location.pathname,
			});
		};
		if (!window.twikoo) {
			const script = document.createElement("script");
			script.src = twikooScriptSrc;
			script.defer = true;
			script.onload = doInit;
			document.body.appendChild(script);
		} else {
			doInit();
		}
	};
	document.addEventListener("astro:page-load", initTwikooComments);
	initTwikooComments();
</script>
