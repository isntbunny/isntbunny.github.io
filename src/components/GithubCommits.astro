---
// src/components/GithubCommits.astro

const owner = 'isntbunny';
const repo = 'isntbunny.github.io'; 
const apiUrl = `https://api.github.com/repos/${owner}/${repo}/commits?per_page=10`;

let commits = [];
let errorMsg = '';

try {
  const response = await fetch(apiUrl);
  if (response.ok) {
    commits = await response.json();
  } else {
    errorMsg = `GitHub API 请求失败（状态码：${response.status}）`;
  }
} catch (err) {
  errorMsg = '网络错误，无法获取提交记录';
}

// 按日期分组
function groupCommitsByDate(commits) {
  const groups = {};
  
  commits.forEach(commit => {
    const date = new Date(commit.commit.author.date);
    const dateKey = date.toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
    
    if (!groups[dateKey]) {
      groups[dateKey] = [];
    }
    groups[dateKey].push(commit);
  });
  
  return groups;
}

const groupedCommits = commits.length > 0 ? groupCommitsByDate(commits) : {};
const sortedDates = Object.keys(groupedCommits).sort((a, b) => {
  // 将日期字符串转回日期对象进行比较
  const dateA = new Date(a.replace(/年|月/g, '/').replace(/日/g, ''));
  const dateB = new Date(b.replace(/年|月/g, '/').replace(/日/g, ''));
  return dateB - dateA;
});
---

{errorMsg && <p style="color: #888; font-size: 0.9rem;">⚠️ {errorMsg}</p>}

{commits.length > 0 && (
  <div class="commit-list">
    <h3>最近更新</h3>
    {sortedDates.map((dateKey) => {
      const dayCommits = groupedCommits[dateKey];
      
      return (
        <div class="date-group" key={dateKey}>
          <div class="date-header">
            <span class="date-label">{dateKey}</span>
            <span class="commit-count">{dayCommits.length} 次提交</span>
          </div>
          <p>
            {dayCommits.map((commit) => {
              const { message} = commit.commit;
              const firstLine = message.split('\n')[0] || message;

              return (
                <p key={commit.sha} class="msg">{firstLine}</p>
              );
            })}
          </p>
        </div>
      );
    })}
    
    <style>
      .commit-list h3 {
        font-size: 1.2rem;
        margin-bottom: 1rem;
      }
      
      .date-group {
        margin-bottom: 1.5rem;
      }
      
      .date-group:last-child {
        margin-bottom: 0;
      }
      
      .date-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0;
        border-bottom: 2px solid #e1e4e8;
        margin-bottom: 0.5rem;
      }
      
      .date-label {
        font-weight: 600;
        font-size: 1rem;
        color: #24292e;
      }
      
      .commit-count {
        font-size: 0.8rem;
        color: #586069;
        background: #f0f0f0;
        padding: 0.1rem 0.7rem;
        border-radius: 12px;
      }
      
      .commit-list  {
        display:inline;
        padding: 0;
        margin: 0;
      }

      
      .msg {
        display: inline;
        font-weight: 500;
        min-width: 150px;
        color: #24292e;
      }

      .commit-list p::after{
          content: ' ';
          color: #c0c0c0;
      }
      
      .meta {
        font-size: 0.8rem;
        color: #586069;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

    </style>
  </div>
)}