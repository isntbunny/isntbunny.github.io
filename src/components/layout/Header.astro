---
import Snowflake from "@/components/Snowflake.astro";
import { menuLinks } from "@/data/site.config";
---
  <div style="z-index: 99999;">
	    <Snowflake />
		  </div>
<header id="main-header">
	<div class="hpwrapper"><a aria-current={Astro.url.pathname === "/" ? "page" : false} class="site-nav-link" href="/"
	>
	<img class="headpic" src="https://i.postimg.cc/52jdV8tV/1.gif"></a
></div>
	<nav aria-label="Main menu" class="site-nav-shell">
		<div class="site-nav-links">

			{
				menuLinks.map((link) => (
					<a
						aria-current={Astro.url.pathname === link.path ? "page" : false}
						class="site-nav-link"
						href={link.path}
						target={link.external ? "_blank" : undefined}
						rel={link.external ? "noreferrer" : undefined}
					>
						{link.title}
					</a>
				))
			}
		</div>

	</nav>

</header>

<style>
	#main-header { 
	position: relative;
	inset: 0px 0 0 0;
	z-index: 100;
	min-height: var(--header-height);
	padding: 0;
	background:#e4ebf2;
	backdrop-filter: blur(28px);
	-webkit-backdrop-filter: blur(28px);
	border-bottom: 1px solid #c8d4e0;
	box-shadow: 0 8px 24px rgba(160, 190, 215, 0.16);
}

.site-nav-shell {
	padding: 0.5em;
    text-decoration: none;
	display: flex;
	align-items: center;
	justify-content: center; 
	margin: 0 auto;
}

.site-nav-links {
	font-family: "smalle";
	display: flex;
	flex-wrap: wrap;
	gap: 16px;
}

.site-nav-link {
    text-decoration: none;
	text-align:center;
	position: relative;
	color: var(--text-main);
	transition: color 0.2s ease, transform 0.2s ease;
}

.site-nav-link:hover {
	color: var(--ink-faint);
	transform: translateY(-1px);
}
.site-nav-link[aria-current="page"] {
	color: #8aa3b9cc;
	font-weight: bold;
	text-decoration: underline dotted;
}

.headpic {
  max-width: 100%;
  border-bottom: 1px solid #c8d4e0;
  position: relative;
  z-index: 1;
}

@media (max-width: 768px) {
  .site-nav-shell {
    position: relative;
    overflow: hidden;
  }
  
  .site-nav-links {
    margin: 0;
    padding: 0em 0em; /* 左右留出空间给渐变 */
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    gap: 20px;
   /* mask-image: linear-gradient(to right, transparent, black 20px, black 80%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 20px, black 80%, transparent);
  }*/
  
}

</style>