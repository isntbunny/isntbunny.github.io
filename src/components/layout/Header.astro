---
import { menuLinks } from "@/site.config";
import HamburgerMenu from "@/components/layout/HamburgerMenu.astro";
---

<header id="main-header">
		<section> 
			        <img class="headpic" src="/public/1.gif">
						</section>
	<nav aria-label="Main menu" class="site-nav-shell">
		<!--<a class="site-logo" href="/">Eucaly's Blog</a> -->
		<div class="site-nav-links">
			<a aria-current={Astro.url.pathname === "/" ? "page" : false} class="site-nav-link" href="/"
				>Home</a
			>
			{
				menuLinks.map((link) => (
					<a
						aria-current={Astro.url.pathname === link.path ? "page" : false}
						class="site-nav-link"
						href={link.path}
						target={link.external ? "_blank" : undefined}
						rel={link.external ? "noreferrer" : undefined}
					>
						{link.title}
					</a>
				))
			}
		</div>

	</nav>
</header>
<style>
	#main-header { 
	position: relative;
	inset: 0px 0 0 0;
	z-index: 100;
	min-height: var(--header-height);
	padding: 0;
	background: rgba(255, 255, 255, 0.58);
	backdrop-filter: blur(28px);
	-webkit-backdrop-filter: blur(28px);
	border-bottom: 1px solid var(--glass-border);
	box-shadow: 0 8px 24px rgba(160, 190, 215, 0.16);
}

.site-nav-shell {
    text-decoration: none;
	display: flex;
	align-items: center;
	justify-content: center; 
	margin: 0 auto;
}

.site-nav-links {
	font-family: "smalle";
	display: flex;
	flex-wrap: wrap;
	gap: 16px;
}

.site-nav-link {
    text-decoration: none;
	text-align:center;
	position: relative;
	color: var(--text-main);
	transition: color 0.2s ease, transform 0.2s ease;
}

.site-nav-link:hover {
	color: var(--ink-faint);
	transform: translateY(-1px);
}
.site-nav-link[aria-current="page"] {
	color: var(--ink-faint);
}

.headpic {
  max-width: 100%;
}


</style>