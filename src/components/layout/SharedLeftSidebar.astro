---
interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class="home-sidebar-frame home-layout-column shared-left-sidebar" data-compact={compact ? "1" : "0"}>
	<section class="win-card">
		<div class="win-title-bar">WELCOME.EXE</div>
		<div class="win-body">
			<h1 class="title" id="home-typing"></h1>
			<p class="home-welcome-jump" id="home-location">WELCOME FRIEND FROM FAR AWAY :P</p>
			<p id="home-distance">You are ... km away from An-chan.</p>
		</div>
	</section>
	<div class="angel-divider" aria-hidden="true">°‧🪽₊⋆༺✧༻⋆₊🪽‧°</div>
	<a class="win-enter-btn" href="/posts/">Posts</a>
	<a class="win-enter-btn" href="/memos/">Memos</a>
	<a class="win-enter-btn" href="/gallery/">gallery zone</a>
</aside>
