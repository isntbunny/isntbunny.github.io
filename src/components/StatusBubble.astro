</style>

<script>
document.addEventListener('astro:page-load', () => {
    initStatusSwitcher();
});

import { customMessages } from '@/data/custom-messages';
import { wordList, getLearnedWords, saveLearnedWords } from '@/data/words';

function initStatusSwitcher() {
    // ---- DOM 元素 ----
    const refreshBtn = document.getElementById('refreshStatusBtn');
    const wordModeBtn = document.getElementById('wordModeBtn');
    const statusContent = document.getElementById('statuscafe-content');
    const wordContent = document.getElementById('wordContent');
    const wordQuestion = document.getElementById('wordQuestion');
    const wordFeedback = document.getElementById('wordFeedback');
    const wordMeta = document.getElementById('wordMeta');
    const wordOptions = document.getElementById('wordOptions');
    const optionsContainer = document.getElementById('optionsContainer');
    const nextContainer = document.getElementById('nextContainer');
    const usernameEl = document.getElementById('statuscafe-username');
    const bubble = document.getElementById('statusBubble');
    const bunnyImage = document.getElementById('bunnyImage');
    
    // 输入框相关（新增）
    const wordInput = document.getElementById('wordInput');
    const submitAnswerBtn = document.getElementById('submitAnswerBtn');

    // ---- 状态变量 ----
    let allMessages = [];
    let currentIndex = -1;
    let isLoading = false;
    let isTyping = false;
    let statusLoaded = false;
    
    // 单词学习相关
    let isWordMode = false;
    let currentWord = null;
    let isAnswered = false;
    let isEnglishMode = true;
    let wordQueue = [];
    let learnedIds = getLearnedWords();
    let totalWords = wordList.length;
    
    // 防抖
    let lastClickTime = 0;
    const CLICK_DEBOUNCE = 500;

    // GIF 控制相关
    const originalGif = 'https://i.postimg.cc/9MLD69pb/Gif260720.gif';
    // 🔧🔧🔧 替换成你的静态图片地址！比如截取GIF的第一帧保存为PNG
    const staticImage = 'https://i.postimg.cc/HxG7bTwc/avatar250806.png';
    let gifTimer = null;
    let isStatic = false;

    // ---- 选项按钮的清理函数 ----
    function cleanupOptionListeners() {
        const optionBtns = optionsContainer?.querySelectorAll('.option-btn');
        if (optionBtns) {
            optionBtns.forEach(btn => {
                const newBtn = btn.cloneNode(true);
                btn.parentNode.replaceChild(newBtn, btn);
            });
        }
    }

    // ---- GIF 控制函数 ----
    function switchToStaticImage() {
        if (!bunnyImage) return;
        if (isStatic) return;
        
        isStatic = true;
        console.log('切换到静态图片');
        bunnyImage.style.transition = 'opacity 0.1s';
        bunnyImage.style.opacity = '1';
        setTimeout(() => {
            bunnyImage.src = staticImage;
            bunnyImage.style.opacity = '1';
        }, 300);
    }

    function restoreGif() {
        if (gifTimer) {
            clearTimeout(gifTimer);
            gifTimer = null;
        }
        
        if (!bunnyImage) return;
        if (!isStatic) return;
        
        isStatic = false;
        console.log('恢复GIF');
        bunnyImage.style.transition = 'opacity 0.3s';
        bunnyImage.style.opacity = '0';
        setTimeout(() => {
            bunnyImage.src = originalGif;
            bunnyImage.style.opacity = '1';
        }, 300);
    }

    // ---- 从 status.cafe 读取所有状态 ----
    async function fetchAllStatuses() {
        try {
            const response = await fetch('https://status.cafe/users/isntbunny.atom');
            const text = await response.text();
            const parser = new DOMParser();
            const xml = parser.parseFromString(text, 'text/xml');
            const entries = xml.querySelectorAll('entry');
            
            const messages = [];
            entries.forEach((entry) => {
                const content = entry.querySelector('content')?.textContent;
                const title = entry.querySelector('title')?.textContent;
                const message = content || title;
                
                const published = entry.querySelector('published')?.textContent;
                let timeAgo = '';
                if (published) {
                    const date = new Date(published);
                    const now = new Date();
                    const diffMs = now - date;
                    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
                    
                    if (diffDays === 0) {
                        const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
                        if (diffHours === 0) {
                            const diffMins = Math.floor(diffMs / (1000 * 60));
                            timeAgo = diffMins <= 1 ? '刚刚' : `${diffMins} 分钟前`;
                        } else {
                            timeAgo = `${diffHours} 小时前`;
                        }
                    } else if (diffDays === 1) {
                        timeAgo = '昨天';
                    } else {
                        timeAgo = `${diffDays} 天前`;
                    }
                }
                
                if (message && message.trim()) {
                    const cleanMsg = message.trim();
                    if (cleanMsg.length > 0) {
                        messages.push({
                            text: cleanMsg,
                            time: timeAgo,
                            date: published
                        });
                    }
                }
            });
            
            return messages;
        } catch (error) {
            console.error('大脑过载:', error);
            return [];
        }
    }

    // ---- 合并所有消息 ----
    function mergeMessages(statusMessages) {
        const merged = [];
        statusMessages.forEach(msg => {
            merged.push({ 
                type: 'status', 
                text: msg.text,
                time: msg.time,
                date: msg.date
            });
        });
        const shuffled = [...customMessages].sort(() => Math.random() - 0.5);
        shuffled.forEach(msg => {
            merged.push({ 
                type: 'custom', 
                text: msg,
                time: '',
                date: null
            });
        });
        return merged.sort(() => Math.random() - 0.5);
    }

    // ---- 自动滚动到底部 ----
    function autoScrollToBottom(element) {
        if (element) {
            element.scrollTop = element.scrollHeight;
        }
    }

    // ---- 打字机效果 ----
    function typeText(element, text, speed = 89) {
        return new Promise((resolve) => {
            if (isTyping) {
                resolve();
                return;
            }
            isTyping = true;
            let index = 0;
            element.textContent = '';
            
            // 🎯 开始打字时恢复 GIF
            restoreGif();
            
            function typeChar() {
                if (index < text.length) {
                    element.textContent += text.charAt(index);
                    index++;
                    autoScrollToBottom(element);
                    const delay = speed + Math.random() * 15;
                    setTimeout(typeChar, delay);
                } else {
                    isTyping = false;
                    autoScrollToBottom(element);
                    
                    // 🎯 打字完成后切换到静态图片
                    switchToStaticImage();
                    
                    resolve();
                }
            }
            typeChar();
        });
    }

    // ---- 显示状态消息 ----
    async function showMessage(index) {
        if (!allMessages.length || index < 0 || index >= allMessages.length) {
            return;
        }
        if (isTyping) return;
        
        const msg = allMessages[index];
        statusContent.textContent = '';
        await typeText(statusContent, msg.text, 89);
        
        autoScrollToBottom(statusContent);
        
        if (usernameEl) {
            if (msg.type === 'status' && msg.time) {
                usernameEl.textContent = `${msg.time}`;
            } else if (msg.type === 'custom') {
                usernameEl.textContent = '刚刚说道';
            } else {
                usernameEl.textContent = 'thinking';
            }
        }
    }

    // ---- 切换到下一条状态 ----
    async function nextStatus() {
        if (isLoading || isTyping) return;
        
        const now = Date.now();
        if (now - lastClickTime < CLICK_DEBOUNCE) return;
        lastClickTime = now;
        
        if (isWordMode) {
            exitWordMode();
        }
        
        if (allMessages.length === 0) {
            isLoading = true;
            statusContent.textContent = '讓Bunny想一想...';
            autoScrollToBottom(statusContent);
            const statusMessages = await fetchAllStatuses();
            allMessages = mergeMessages(statusMessages);
            currentIndex = -1;
            isLoading = false;
            if (allMessages.length === 0) {
                statusContent.textContent = '不知道humm';
                autoScrollToBottom(statusContent);
                if (usernameEl) usernameEl.textContent = '放棄思考';
                return;
            }
        }
        
        currentIndex = (currentIndex + 1) % allMessages.length;
        await showMessage(currentIndex);
    }

    // ============================================
    // ---- 单词学习功能（输入框版本） ----
    // ============================================

    /**
     * 模糊匹配：判断用户输入是否包含正确答案中的任意一个字
     */
     function isFuzzyMatch(userInput, correctAnswer) {
    if (!userInput || !correctAnswer) return false;
    
    const trimmedInput = userInput.trim();
    if (trimmedInput.length === 0) return false;
    
    // 完全匹配直接通过
    if (trimmedInput === correctAnswer) return true;
    
    // 将正确答案拆成单个汉字
    const correctChars = correctAnswer.split('').filter(char => {
        return /[\u4e00-\u9fa5]/.test(char);
    });
    
    // 如果正确答案只有1个字，那匹配1个字就算对
    if (correctChars.length <= 1) {
        for (const char of correctChars) {
            if (trimmedInput.includes(char)) {
                return true;
            }
        }
        return false;
    }
    
    // 正确答案有2个字及以上时，需要匹配至少2个字
    let matchCount = 0;
    for (const char of correctChars) {
        if (trimmedInput.includes(char)) {
            matchCount++;
            if (matchCount >= 2) {
                return true;
            }
        }
    }
    
    return false;
}


    function getWordQueue() {
        const unlearned = wordList.filter(w => !learnedIds.includes(w.id));
        if (unlearned.length === 0) {
            learnedIds = [];
            saveLearnedWords(learnedIds);
            return [...wordList].sort(() => Math.random() - 0.5);
        }
        return unlearned.sort(() => Math.random() - 0.5);
    }

    function prepareQuestion() {
        wordQueue = getWordQueue();
        
        if (wordQueue.length === 0) {
            wordQuestion.textContent = '太棒了！所有单词都学完了！';
            wordFeedback.textContent = '';
            wordFeedback.style.opacity = '1';
            wordMeta.textContent = ` ${learnedIds.length}/${totalWords}`;
            
            if (wordInput) wordInput.style.display = 'none';
            if (submitAnswerBtn) submitAnswerBtn.style.display = 'none';
            nextContainer.style.display = 'none';
            
            usernameEl.textContent = `完成！`;
            switchToStaticImage();
            return;
        }
        
        showQuestion();
    }

    // ---- 显示题目 ----
    function showQuestion() {
        if (wordQueue.length === 0) {
            prepareQuestion();
            return;
        }

        currentWord = wordQueue[0];
        isAnswered = false;
        
        // 固定模式：显示英文，让用户输入中文
        wordQuestion.textContent = ` ${currentWord.english}`;
        wordMeta.textContent = `已答对 ${learnedIds.length}/${totalWords}`;
        
        wordFeedback.textContent = '';
        wordFeedback.style.opacity = '0';
        wordFeedback.style.color = '';
        
        // 显示输入框
        if (wordInput) {
            wordInput.style.display = 'block';
            wordInput.value = '';
            wordInput.disabled = false;
            wordInput.focus();
        }
        if (submitAnswerBtn) {
            submitAnswerBtn.style.display = 'block';
            submitAnswerBtn.disabled = false;
        }
        nextContainer.style.display = 'none';
        
        usernameEl.textContent = `已答对 ${learnedIds.length}/${totalWords}`;
        
        // 🎯 显示题目时恢复 GIF，3秒后切换静态图片
        restoreGif();
        if (gifTimer) clearTimeout(gifTimer);
        gifTimer = setTimeout(() => {
            if (!isAnswered) {
                switchToStaticImage();
            }
        }, 3000);
    }

    // ---- 处理回答（输入框版本） ----
    function handleAnswer() {
        if (isAnswered || !currentWord) return;
        if (!wordInput) return;
        
        const userInput = wordInput.value;
        if (userInput.trim().length === 0) {
            // 空输入提示
            wordFeedback.textContent = '请输入你的答案哦~';
            wordFeedback.style.color = '#f59e0b';
            wordFeedback.style.opacity = '1';
            return;
        }
        
        isAnswered = true;
        
        // 🎯 回答时清除定时器，恢复 GIF
        if (gifTimer) {
            clearTimeout(gifTimer);
            gifTimer = null;
        }
        restoreGif();
        
        // 禁用输入框和按钮
        if (wordInput) wordInput.disabled = true;
        if (submitAnswerBtn) submitAnswerBtn.disabled = true;
        
        const correctAnswer = currentWord.chinese;
        const isCorrect = isFuzzyMatch(userInput, correctAnswer);
        
        if (isCorrect) {
            if (!learnedIds.includes(currentWord.id)) {
                learnedIds.push(currentWord.id);
                saveLearnedWords(learnedIds);
            }
            wordFeedback.textContent = `答对了捏！厉害—— (${correctAnswer})`;
            wordFeedback.style.color = '#4ade80';
        } else {
            wordFeedback.textContent = `啊哦。有点小失误。正确答案是：「${correctAnswer}」`;
            wordFeedback.style.color = '#f87171';
        }
        
        wordFeedback.style.opacity = '1';
        
        // 从队列中移除当前单词
        wordQueue = wordQueue.filter(w => w.id !== currentWord.id);
        
        // 显示下一个按钮
        nextContainer.style.display = 'block';
        
        // 🎯 回答完成后切换到静态图片
        switchToStaticImage();
    }

    // ---- 处理下一个 ----
    function handleNext() {
        showQuestion();
    }

    // ---- 退出单词模式 ----
    function exitWordMode() {
        isWordMode = false;
        statusContent.style.display = 'flex';
        wordContent.style.display = 'none';
        wordOptions.style.display = 'none';
        wordModeBtn.textContent = '背单词';
        wordModeBtn.classList.remove('active');
        refreshBtn.style.display = 'inline-block';
        cleanupOptionListeners();
        
        if (gifTimer) {
            clearTimeout(gifTimer);
            gifTimer = null;
        }
    }

    // ---- 切换模式 ----
    function toggleWordMode() {
        if (isWordMode) {
            exitWordMode();
            if (allMessages.length > 0) {
                const idx = currentIndex >= 0 ? currentIndex : 0;
                showMessage(idx);
            }
        } else {
            isWordMode = true;
            statusContent.style.display = 'none';
            wordContent.style.display = 'flex';
            wordOptions.style.display = 'block';
            wordModeBtn.textContent = '退出';
            wordModeBtn.classList.add('active');
            refreshBtn.style.display = 'none';
            
            // 显示输入框（确保可见）
            if (wordInput) wordInput.style.display = 'block';
            if (submitAnswerBtn) submitAnswerBtn.style.display = 'block';
            
            learnedIds = getLearnedWords();
            prepareQuestion();
        }
    }

    // ============================================
    // 事件绑定
    // ============================================
    
    if (refreshBtn) {
        refreshBtn.addEventListener('click', nextStatus);
    }
    
    if (wordModeBtn) {
        wordModeBtn.addEventListener('click', toggleWordMode);
    }
    
    // 绑定确认按钮
    if (submitAnswerBtn) {
        submitAnswerBtn.replaceWith(submitAnswerBtn.cloneNode(true));
        const newSubmitBtn = document.getElementById('submitAnswerBtn');
        if (newSubmitBtn) {
            newSubmitBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                handleAnswer();
            });
        }
    }
    
    // 绑定下一个按钮
    const nextBtn = document.getElementById('nextWordBtn');
    if (nextBtn) {
        nextBtn.replaceWith(nextBtn.cloneNode(true));
        const newNextBtn = document.getElementById('nextWordBtn');
        if (newNextBtn) {
            newNextBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                handleNext();
            });
        }
    }
    
    // 输入框回车键提交
    if (wordInput) {
        wordInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (isAnswered) {
                    handleNext();
                } else {
                    handleAnswer();
                }
            }
        });
    }
    
    if (bubble) {
        bubble.addEventListener('click', () => {
            if (isWordMode) return;
            const now = Date.now();
            if (now - lastClickTime < CLICK_DEBOUNCE) return;
            lastClickTime = now;
            nextStatus();
        });
    }

    // ---- 键盘快捷键（简化版） ----
    document.addEventListener('keydown', (e) => {
        if (!isWordMode) return;
        
        if (isAnswered && (e.key === 'Enter' || e.key === ' ')) {
            e.preventDefault();
            handleNext();
            return;
        }
    });

    // ---- 页面加载初始化 ----
    async function init() {
        try {
            statusContent.textContent = '最近好像没有什么可说的呢......（思考）';
            autoScrollToBottom(statusContent);
            
            const statusMessages = await fetchAllStatuses();
            allMessages = mergeMessages(statusMessages);
            statusLoaded = true;
            
            if (allMessages.length > 0) {
                currentIndex = 0;
                await showMessage(0);
                autoScrollToBottom(statusContent);
            } else {
                statusContent.textContent = 'Bunny暂时失忆了...';
                autoScrollToBottom(statusContent);
                if (usernameEl) usernameEl.textContent = '放棄思考';
            }
        } catch (error) {
            console.error('初始化失败:', error);
            statusContent.textContent = '大脑过载，请稍后再试';
            autoScrollToBottom(statusContent);
            if (usernameEl) usernameEl.textContent = '故障中';
        }
        
        // 🎯 初始化完成后切换到静态图片
        switchToStaticImage();
    }
    
    init();
}

</script>