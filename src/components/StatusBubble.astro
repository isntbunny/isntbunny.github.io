    bottom:0em;
}

.refresh-btn{
}

#statuscafe-username a{
  text-decoration: none;
}
#statuscafe-username {
  color: white;
}


@media (max-width: 860px){
  .bubbling-me img{/* 
    position:absolute;
    top:44%;
    left:85%;*/
    width:5em;
  }
  .bub-pic {
    width: 100%;
    padding-bottom: 45%; 
    left: -1em;
    top:-1em;
  }
  .bub {
    text-align: center;
    font-size: 12px;
    top: 7%;
    left: 1%;
    right: 1%;
    bottom: 20%;
    padding: 6px 8px;
  }

  #statuscafe-content {
    font-size: 13px;
  }
}
</style>


<script>
    document.addEventListener('astro:page-load', () => {initStatusSwitcher();});
    import { customMessages } from '@/data/custom-messages';
    function initStatusSwitcher() {
        const refreshBtn = document.getElementById('refreshStatusBtn');
        const statusContent = document.getElementById('statuscafe-content');
        const usernameEl = document.getElementById('statuscafe-username');
        
        let statusList = [];
        let allMessages = [];
        let currentIndex = -1;
        let isLoading = false;
        let isTyping = false;
        
        // 从 status.cafe 读取所有状态
        async function fetchAllStatuses() {
            try {
                const response = await fetch('https://status.cafe/users/isntbunny.atom');
                const text = await response.text();
                const parser = new DOMParser();
                const xml = parser.parseFromString(text, 'text/xml');
                const entries = xml.querySelectorAll('entry');
                
                const messages = [];
                entries.forEach((entry) => {
                    const content = entry.querySelector('content')?.textContent;
                    const title = entry.querySelector('title')?.textContent;
                    const message = content || title;
                    
                    const published = entry.querySelector('published')?.textContent;
                    let timeAgo = '';
                    if (published) {
                        const date = new Date(published);
                        const now = new Date();
                        const diffMs = now - date;
                        const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
                        
                        if (diffDays === 0) {
                            const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
                            if (diffHours === 0) {
                                const diffMins = Math.floor(diffMs / (1000 * 60));
                                timeAgo = diffMins <= 1 ? '刚刚' : `${diffMins} 分钟前`;
                            } else {
                                timeAgo = `${diffHours} 小时前`;
                            }
                        } else if (diffDays === 1) {
                            timeAgo = '昨天';
                        } else {
                            timeAgo = `${diffDays} 天前`;
                        }
                    }
                    
                    if (message && message.trim()) {
                        const cleanMsg = message.trim();
                        if (cleanMsg.length > 0) {
                            messages.push({
                                text: cleanMsg,
                                time: timeAgo,
                                date: published
                            });
                        }
                    }
                });
                
                return messages;
            } catch (error) {
                console.error('大脑过载:', error);
                return [];
            }
        }
        
        // 合并所有消息
        function mergeMessages(statusMessages) {
            const merged = [];
            
            statusMessages.forEach(msg => {
                merged.push({ 
                    type: 'status', 
                    text: msg.text,
                    time: msg.time,
                    date: msg.date
                });
            });
            
            const shuffled = [...customMessages].sort(() => Math.random() - 0.5);
            shuffled.forEach(msg => {
                merged.push({ 
                    type: 'custom', 
                    text: msg,
                    time: '',
                    date: null
                });
            });
            
            return merged.sort(() => Math.random() - 0.5);
        }
        
        // 检查内容是否溢出
        function isOverflowing(element) {
            return element.scrollHeight > element.clientHeight;
        }
        
        // 调整居中状态
        function updateAlignment(element) {
            if (isOverflowing(element)) {
                element.style.alignItems = 'flex-start';
                element.style.justifyContent = 'flex-start';
                element.scrollTop = element.scrollHeight;
            } else {
                element.style.alignItems = 'center';
                element.style.justifyContent = 'center';
                element.scrollTop = 0;
            }
        }
        
        // 强制滚动到底部（用于打字时）
        function scrollToBottom() {
            statusContent.scrollTop = statusContent.scrollHeight;
            const bub = statusContent.closest('.bub');
            if (bub && bub.scrollHeight > bub.clientHeight) {
                bub.scrollTop = bub.scrollHeight;
            }
        }
        
        // 打字机效果
        function typeText(element, text, speed = 89) {
            return new Promise((resolve) => {
                if (isTyping) {
                    resolve();
                    return;
                }
                isTyping = true;
                
                let index = 0;
                element.textContent = '';
                element.scrollTop = 0;
                element.style.alignItems = 'center';
                element.style.justifyContent = 'center';
                
                function typeChar() {
                    if (index < text.length) {
                        element.textContent += text.charAt(index);
                        index++;
                        
                        updateAlignment(element);
                        if (isOverflowing(element)) {
                            element.scrollTop = element.scrollHeight;
                        }
                        
                        const delay = speed + Math.random() * 15;
                        setTimeout(typeChar, delay);
                    } else {
                        isTyping = false;
                        updateAlignment(element);
                        if (isOverflowing(element)) {
                            element.scrollTop = element.scrollHeight;
                        }
                        resolve();
                    }
                }
                
                typeChar();
            });
        }
        
        // 显示指定索引的消息
        async function showMessage(index) {
            if (!allMessages.length || index < 0 || index >= allMessages.length) {
                return;
            }
            
            if (isTyping) {
                return;
            }
            
            const msg = allMessages[index];
            
            statusContent.textContent = '';
            await typeText(statusContent, msg.text, 89);
            
            if (usernameEl) {
                if (msg.type === 'status' && msg.time) {
                    usernameEl.textContent = `${msg.time}`;
                } else if (msg.type === 'custom') {
                    usernameEl.textContent = '剛剛';
                } else {
                    usernameEl.textContent = 'thinking';
                }
            }
        }
        
        // 切换到下一条
        async function nextStatus() {
            if (isLoading || isTyping) return;
            
            const isDefaultStatus = statusContent.textContent.includes('最近好像没有什么可说的呢');
            
            if (allMessages.length === 0) {
                isLoading = true;
                statusContent.textContent = '讓Bunny想一想...';
                
                const statusMessages = await fetchAllStatuses();
                allMessages = mergeMessages(statusMessages);
                currentIndex = -1;
                isLoading = false;
                
                if (allMessages.length === 0) {
                    statusContent.textContent = '不知道humm';
                    if (usernameEl) {
                        usernameEl.textContent = '放棄思考';
                    }
                    return;
                }
            }
            
            currentIndex = (currentIndex + 1) % allMessages.length;
            const msg = allMessages[currentIndex];
            
            // 从默认状态切换时，先显示"哦对了！"
            if (isDefaultStatus) {
                statusContent.textContent = '最近好像没有什么可说的呢....（思索）';
                await typeText(statusContent, '哦对了！', 100);
                await new Promise(resolve => setTimeout(resolve, 300));
                statusContent.textContent = '';
            }
            
            await showMessage(currentIndex);
        }
        
        // 点击按钮切换
        if (refreshBtn) {
            refreshBtn.addEventListener('click', nextStatus);
        }
        
        // 点击气泡切换
        const bubble = document.getElementById('statusBubble');
        if (bubble) {
            bubble.addEventListener('click', nextStatus);
        }
        
        // 页面加载后自动加载第一条
        setTimeout(async () => {
            const statusMessages = await fetchAllStatuses();
            allMessages = mergeMessages(statusMessages);
            if (allMessages.length > 0) {
                currentIndex = 0;
                await showMessage(0);
            }
        }, 1500);
    }
    </script>