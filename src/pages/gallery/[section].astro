---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import PageLayout from "@/pages/layouts/Base.astro";
import "/src/styles/pages/gallery.css";

export const getStaticPaths = (async () => {
	const [gallery] = await getCollection("gallery");
	if (!gallery) return [];
	return gallery.data.sections.map((section) => ({
		params: { section: section.slug },
		props: { sectionData: section },
	}));
}) satisfies GetStaticPaths;

const { sectionData } = Astro.props;
const allItems = sectionData.months.flatMap((group) =>
	group.items.map((item) => ({ ...item, month: group.month })),
);
const groupedByYearMonth = allItems.reduce((acc, item, idx) => {
	const year = item.date ? new Date(item.date).getFullYear() : item.month?.slice(0, 4);
	const monthFull = item.month; // "2025-12"
	const monthNum = monthFull?.slice(5, 7); // 提取 "12"
	
	if (!acc[year]) acc[year] = {};
	if (!acc[year][monthNum]) acc[year][monthNum] = [];
	acc[year][monthNum].push({ ...item, globalIndex: idx });
	return acc;
}, {});

const sortedYears = Object.keys(groupedByYearMonth).sort((a, b) => b.localeCompare(a));
---

<PageLayout meta={{ title: sectionData.title, description: sectionData.description ?? "Gallery section" }}>
	<a href="/gallery/" class="gallery-back">← Back</a>
	<h1>{sectionData.title}</h1>
	{
		sortedYears.map(year => (
			<section class="gallery-year-section">
				<h2 class="gallery-year-title">{year}</h2>
				{Object.entries(groupedByYearMonth[year])
					.sort((a, b) => b[0].localeCompare(a[0])) // 月份倒序
					.map(([month, items]) => (
						<div class="gallery-month-group">
							<h3 class="gallery-month-title">{month}</h3>
							<div class="gallery-grid">
								{items.map((item) => (
									<article
										class="site-card gallery-tile"
										data-index={item.globalIndex}
										data-src={item.image}
										data-title={item.title}
										data-desc={item.description ?? item.month}
									>
										<div style="position: relative;">
											<div class="gallery-skeleton" />
											<img src={item.image} alt={item.title} class="gallery-image" loading="lazy" />
										</div>
										<p>{item.title}</p>
										<p class="small-muted">{item.description ?? item.month}</p>
									</article>
								))}
							</div>
						</div>
					))}
			</section>
		))
	}

	<div class="gallery-lightbox" id="gallery-lightbox" hidden>
		<button class="gallery-arrow" data-dir="prev" type="button">←</button>
		<div>
			<img id="gallery-lightbox-image" src="" alt="" />
			<p id="gallery-lightbox-text"></p>
		</div>
		<button class="gallery-arrow" data-dir="next" type="button">→</button>
	</div>
</PageLayout>

<script is:inline>
	(function() {
	  // 等待 DOM 就绪
	  if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	  } else {
		init();
	  }
	
	  function init() {
		console.log('Gallery init started');
		
		// 获取元素
		const box = document.getElementById('gallery-lightbox');
		const lightboxImage = document.getElementById('gallery-lightbox-image');
		const text = document.getElementById('gallery-lightbox-text');
		
		// 关键：强制确保弹窗是隐藏的
		if (box) {
		  box.setAttribute('hidden', 'hidden');
		  box.style.display = ''; // 确保不是被其他样式覆盖
		  console.log('Lightbox hidden');
		} else {
		  console.error('Lightbox element not found');
		  return;
		}
		
		// 获取所有卡片
		const tiles = document.querySelectorAll('.gallery-tile');
		console.log('Found tiles:', tiles.length);
		
		// 骨架屏处理
		tiles.forEach(tile => {
		  const img = tile.querySelector('img');
		  const skeleton = tile.querySelector('.gallery-skeleton');
		  if (img && skeleton) {
			if (img.complete) {
			  skeleton.setAttribute('hidden', 'hidden');
			} else {
			  img.addEventListener('load', () => {
				skeleton.setAttribute('hidden', 'hidden');
			  });
			}
		  }
		});
		
		// 当前索引
		let currentIndex = 0;
		
		// 打开弹窗函数
		function openLightbox(index) {
		  console.log('Opening lightbox at index:', index);
		  const tile = tiles[index];
		  if (!tile) return;
		  
		  const src = tile.getAttribute('data-src');
		  const title = tile.getAttribute('data-title');
		  const desc = tile.getAttribute('data-desc');
		  
		  if (!src) return;
		  
		  lightboxImage.src = src;
		  lightboxImage.alt = title || '';
		  text.textContent = `${title || ''} — ${desc || ''}`;
		  box.removeAttribute('hidden');
		  currentIndex = index;
		}
		
		// 关闭弹窗函数
		function closeLightbox() {
		  console.log('Closing lightbox');
		  box.setAttribute('hidden', 'hidden');
		}
		
		// 绑定图片点击事件
		tiles.forEach((tile, index) => {
		  const img = tile.querySelector('img');
		  if (!img) return;
		  if (img.hasAttribute('data-bound')) return;
		  
		  img.setAttribute('data-bound', 'true');
		  img.style.cursor = 'pointer';
		  img.addEventListener('click', (e) => {
			e.stopPropagation();
			openLightbox(index);
		  });
		});
		
		// 绑定弹窗背景点击关闭
		box.addEventListener('click', (e) => {
		  if (e.target === box) {
			closeLightbox();
		  }
		});
		
		// 绑定左右箭头
		const prevBtn = document.querySelector('.gallery-arrow[data-dir="prev"]');
		const nextBtn = document.querySelector('.gallery-arrow[data-dir="next"]');
		
		if (prevBtn) {
		  prevBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const newIndex = (currentIndex - 1 + tiles.length) % tiles.length;
			openLightbox(newIndex);
		  });
		}
		
		if (nextBtn) {
		  nextBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const newIndex = (currentIndex + 1) % tiles.length;
			openLightbox(newIndex);
		  });
		}
		
		// ESC 键关闭
		document.addEventListener('keydown', (e) => {
		  if (e.key === 'Escape' && box && !box.hasAttribute('hidden')) {
			closeLightbox();
		  }
		});
		
		console.log('Gallery init complete');
	  }
	})();
	</script>