---
import type { GetStaticPaths } from "astro";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async ({ paginate }) =>
	paginate([0], { pageSize: 1 })) satisfies GetStaticPaths;
---

<PageLayout meta={{ description: "status.cafe stream", title: "Memos" }}>
	<section class="memo-flow">
		<h1>Memos</h1>
		<div id="memo-list"></div>
		<button class="memo-loadmore" id="memo-loadmore" type="button">Load more</button>
	</section>
</PageLayout>

<script is:inline>
	let currentPage = 1;
	let memoItems = [];
	let hasNextPage = true;

	const parseStatusFeed = (xmlText) =>
		[...xmlText.matchAll(/<entry>([\s\S]*?)<\/entry>/gi)]
			.map((entry) => {
				const body = entry[1] ?? "";
				const updated = body.match(/<updated>([\s\S]*?)<\/updated>/i)?.[1]?.trim() ?? "";
				const content = (body.match(/<content[^>]*>([\s\S]*?)<\/content>/i)?.[1] ?? "")
					.replace(/<[^>]*>/g, " ")
					.replace(/\s+/g, " ")
					.trim();
				if (!content || Number.isNaN(new Date(updated).valueOf())) return null;
				return { updated, content };
			})
			.filter(Boolean);

	const parseStatusPage = (htmlText) => {
		const parser = new DOMParser();
		const doc = parser.parseFromString(htmlText, "text/html");
		const cards = [...doc.querySelectorAll(".status, .status-box, article")];
		const parsed = cards
			.map((node) => {
				const content =
					node.querySelector(".status-content, .status_text, p")?.textContent?.trim() ?? "";
				const updated =
					node.querySelector("time")?.getAttribute("datetime") ||
					node.querySelector(".status-date, .status_time")?.textContent?.trim() ||
					"";
				if (!content) return null;
				return { updated: updated || new Date().toISOString(), content };
			})
			.filter(Boolean);
		const hasNext = !!doc.querySelector('a[rel="next"], .pagination a.next, a[aria-label*="Next"]');
		return { items: parsed, hasNext };
	};

	const renderItems = (items) => {
		const list = document.getElementById("memo-list");
		if (!list || !items.length) return;
		list.insertAdjacentHTML(
			"beforeend",
			items
				.map(
					(item) => `
				<article class="memo-item">
					<div class="memo-time-line"></div>
					<div class="site-card">
						<time class="memo-time">${new Date(item.updated).toLocaleString("zh-CN")}</time>
						<p class="memo-content">${item.content}</p>
					</div>
				</article>
			`,
				)
				.join(""),
		);
	};

	const fetchMemoPage = async (page) => {
		const atomUrl = `https://status.cafe/users/isntbunny.atom?page=${page}`;
		try {
			const raw = await fetch(
				`https://api.allorigins.win/raw?url=${encodeURIComponent(atomUrl)}`,
			).then((res) => res.text());
			const entries = parseStatusFeed(raw);
			if (entries.length) {
				return { items: entries, hasNext: entries.length > 0 };
			}
		} catch {
			// fallback to profile page parser
		}

		const profileUrl = `https://status.cafe/users/isntbunny?page=${page}`;
		const raw = await fetch(
			`https://api.allorigins.win/raw?url=${encodeURIComponent(profileUrl)}`,
		).then((res) => res.text());
		return parseStatusPage(raw);
	};

	const updateLoadMore = () => {
		const more = document.getElementById("memo-loadmore");
		if (!more) return;
		more.toggleAttribute("hidden", !hasNextPage);
		more.textContent = hasNextPage ? "Load more" : "No more memos";
	};

	const loadNextPage = async () => {
		const more = document.getElementById("memo-loadmore");
		if (!more || !hasNextPage) return;
		more.textContent = "Loading...";
		more.setAttribute("disabled", "disabled");
		try {
			const { items, hasNext } = await fetchMemoPage(currentPage);
			if (!items.length && currentPage === 1) {
				document.getElementById("memo-list").innerHTML =
					`<p class="site-card">Unable to load status feed right now.</p>`;
				hasNextPage = false;
			} else {
				memoItems = memoItems.concat(items);
				renderItems(items);
				currentPage += 1;
				hasNextPage = hasNext && items.length > 0;
			}
		} catch {
			hasNextPage = false;
			if (currentPage === 1) {
				document.getElementById("memo-list").innerHTML =
					`<p class="site-card">Unable to load status feed right now.</p>`;
			}
		}
		more.removeAttribute("disabled");
		updateLoadMore();
	};

	const initMemos = async () => {
		const list = document.getElementById("memo-list");
		const more = document.getElementById("memo-loadmore");
		if (!list || !more) return;
		list.innerHTML = "";
		memoItems = [];
		currentPage = 1;
		hasNextPage = true;
		await loadNextPage();
		if (more.dataset.bound !== "1") {
			more.dataset.bound = "1";
			more.addEventListener("click", loadNextPage);
		}
	};
	document.addEventListener("astro:page-load", initMemos);
	initMemos();
</script>
