---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import { siteSettings } from "@/settings/site";
import { getAllNotes } from "@/data/note";
import PageLayout from "@/layouts/Base.astro";

type StatusCafeItem = {
	source: "status.cafe";
	id: string;
	text: string;
	publishDate: Date;
};

type MemoItem =
	| { source: "note"; id: string; publishDate: Date; note: CollectionEntry<"note"> }
	| StatusCafeItem;

const parseStatusFeed = (xml: string): StatusCafeItem[] =>
	[...xml.matchAll(/<entry>([\s\S]*?)<\/entry>/gi)]
		.map((entry) => {
			const body = entry[1] ?? "";
			const id = body.match(/<id>([\s\S]*?)<\/id>/i)?.[1]?.trim() ?? "";
			const updated = body.match(/<updated>([\s\S]*?)<\/updated>/i)?.[1]?.trim() ?? "";
			const content = body
				.match(/<content[^>]*>([\s\S]*?)<\/content>/i)?.[1]
				?.replace(/&lt;/g, "<")
				?.replace(/&gt;/g, ">")
				?.replace(/&amp;/g, "&")
				?.replace(/<[^>]*>/g, " ")
				?.replace(/\s+/g, " ")
				?.trim() ?? "";
			const publishDate = new Date(updated);
			if (!id || !content || Number.isNaN(publishDate.valueOf())) return null;
			return { source: "status.cafe" as const, id, text: content, publishDate };
		})
		.filter((item): item is StatusCafeItem => item !== null)
		.sort((a, b) => b.publishDate.valueOf() - a.publishDate.valueOf());

export const getStaticPaths = (async ({ paginate }) => {
	const notes = await getAllNotes();
	const statusItems: StatusCafeItem[] = await (async () => {
		try {
			const response = await fetch(siteSettings.statusCafe.atomUrl);
			if (!response.ok) return [];
			return parseStatusFeed(await response.text());
		} catch {
			return [];
		}
	})();
	const noteItems: MemoItem[] = notes.map((note) => ({
		source: "note",
		id: note.id,
		publishDate: note.data.publishDate,
		note,
	}));
	return paginate([...noteItems, ...statusItems].sort((a, b) => b.publishDate.valueOf() - a.publishDate.valueOf()), { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<MemoItem> };
---

<PageLayout meta={{ description: "status.cafe", title: "Memos" }}>
	<div class="mb-12 flex items-center gap-3">
		<h1 class="title">Memos</h1>
	</div>

	<div class="mb-6 hidden" id="statuscafe-latest"></div>
	<ul class="space-y-6" role="list">
		{page.data.map((memo) =>
			memo.source === "note" ? (
				<li><Note note={memo.note} as="h2" isPreview /></li>
			) : (
				<li class="status-card inline-grid w-full" data-statuscafe-id={memo.id}>
					<time class="mt-1 block text-sm text-gray-500 dark:text-gray-400" datetime={memo.publishDate.toISOString()}>
						{memo.publishDate.toLocaleString("zh-CN")}
					</time>
					<p class="mt-3 whitespace-pre-wrap">{memo.text}</p>
				</li>
			),
		)}
	</ul>
	<Pagination
		{...(page.url.prev && { prevUrl: { text: "← Previous Page", url: page.url.prev } })}
		{...(page.url.next && { nextUrl: { text: "Next Page →", url: page.url.next } })}
	/>
</PageLayout>

<script define:vars={{ statusCafeAtomUrl: siteSettings.statusCafe.atomUrl }} is:inline>
	const parseStatusFeed = (xmlText) => [...xmlText.matchAll(/<entry>([\s\S]*?)<\/entry>/gi)].map((entry) => {
		const body = entry[1] ?? "";
		const id = body.match(/<id>([\s\S]*?)<\/id>/i)?.[1]?.trim() ?? "";
		const updated = body.match(/<updated>([\s\S]*?)<\/updated>/i)?.[1]?.trim() ?? "";
		const content = body.match(/<content[^>]*>([\s\S]*?)<\/content>/i)?.[1]?.replace(/&lt;/g, "<")?.replace(/&gt;/g, ">")?.replace(/&amp;/g, "&")?.replace(/<[^>]*>/g, " ")?.replace(/\s+/g, " ")?.trim() ?? "";
		if (!id || !content || Number.isNaN(new Date(updated).valueOf())) return null;
		return { id, content, updated };
	}).filter(Boolean);

	const syncLatestStatusCafe = async () => {
		const container = document.getElementById("statuscafe-latest");
		if (!container) return;
		try {
			const res = await fetch(`${statusCafeAtomUrl}?t=${Date.now()}`, { cache: "no-store" });
			if (!res.ok) return;
			const latest = parseStatusFeed(await res.text())[0];
			if (!latest) return;
			container.innerHTML = `<article class="status-card inline-grid w-full"><time class="mt-1 block text-sm text-gray-500 dark:text-gray-400">${new Date(latest.updated).toLocaleString("zh-CN")}</time><p class="mt-3 whitespace-pre-wrap">${latest.content}</p></article>`;
			container.classList.remove("hidden");
		} catch {
			// ignore network errors
		}
	};
	document.addEventListener("astro:page-load", syncLatestStatusCafe);
	syncLatestStatusCafe();
</script>
