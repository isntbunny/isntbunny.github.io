---
import { getEntry, render } from "astro:content";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "欢迎留言",
	title: "Guestbook",
};

const guestbookEntry = await getEntry("page", "guestbook");
if (!guestbookEntry) throw new Error("Missing src/content/page/guestbook.md");
const { Content } = await render(guestbookEntry);
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Guestbook</h1>
	<div class="prose prose-sm prose-cactus mb-6 max-w-none">
		<Content />
	</div>
	<div id="twikoo">

	</div>
</PageLayout>

<script>
	if (typeof window !== "undefined") {
		const script = document.createElement("script");
		script.src = "https://cdn.jsdelivr.net/npm/twikoo/dist/twikoo.all.min.js";
		script.defer = true;
		script.onload = () => {
			twikoo.init({
				envId: "https://eucaly.netlify.app/.netlify/functions/twikoo",
				el: "#twikoo",
				path: window.location.pathname,
			});
		};
		document.body.appendChild(script);
	}
</script>
