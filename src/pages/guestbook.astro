---
import { getEntry, render } from "astro:content";
import { siteSettings } from "@/config/site-settings";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "欢迎留言～",
	title: "Guestbook",
};

const guestbookEntry = await getEntry("page", "guestbook");
if (!guestbookEntry) throw new Error("Missing src/content/page/guestbook.md");
const { Content } = await render(guestbookEntry);
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Guestbook</h1>
	<div class="prose prose-sm prose-cactus mb-6 max-w-none">
		<Content />
	</div>
	<div id="twikoo"></div>
</PageLayout>

<script define:vars={{ twikooEnvId: siteSettings.comments.twikoo.envId, twikooScriptSrc: siteSettings.comments.twikoo.scriptSrc }}>
	if (typeof window !== "undefined") {
		const script = document.createElement("script");
		script.src = twikooScriptSrc;
		script.defer = true;
		script.onload = () => {
			// @ts-expect-error twikoo is injected by script
			twikoo.init({
				envId: twikooEnvId,
				el: "#twikoo",
				path: window.location.pathname,
			});
		};
		document.body.appendChild(script);
	}
</script>
