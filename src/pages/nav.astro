---
import fs from 'node:fs/promises';
import path from 'node:path';

const navDir = path.join(process.cwd(), 'src/content/nav');
let sections = [];

try {
  const files = await fs.readdir(navDir);
  const mdFiles = files.filter((file) => file.endsWith('.md'));

  for (const file of mdFiles) {
    const fullPath = path.join(navDir, file);
    const content = await fs.readFile(fullPath, 'utf-8');

    const frontmatterMatch = content.match(/^---\r?\n([\s\S]*?)\r?\n---/);

    let sectionTitle = '未命名';
    let sectionIcon = '📁';
    let sectionOrder = 0;

    if (frontmatterMatch) {
      const yaml = frontmatterMatch[1];

      const titleMatch =
        yaml.match(/title:\s*"([^"]+)"/) ||
        yaml.match(/title:\s*'([^']+)'/) ||
        yaml.match(/title:\s*(.+)/);

      const iconMatch =
        yaml.match(/icon:\s*"([^"]+)"/) ||
        yaml.match(/icon:\s*'([^']+)'/) ||
        yaml.match(/icon:\s*(.+)/);

      const orderMatch = yaml.match(/order:\s*(\d+)/);

      sectionTitle = titleMatch?.[1]?.trim() || '未命名';
      sectionIcon = iconMatch?.[1]?.trim() || '📁';
      sectionOrder = orderMatch ? Number.parseInt(orderMatch[1], 10) : 0;
    }

    const body = content.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, '');
    const lines = body.split(/\r?\n/);

    const groups = [];
    const groupMap = new Map();

    let currentGroup = '其他';

    for (const line of lines) {
      const headingMatch = line.match(/^##\s+(.+)/);

      if (headingMatch) {
        currentGroup = headingMatch[1].trim();
        continue;
      }

      const linkMatch = line.match(
        /^\s*-\s*\[([^\]]+)\]\(([^)]+)\)\s*(?:-\s*)?(.*)$/,
      );

      if (!linkMatch) continue;

      const name = linkMatch[1].trim();
      const url = linkMatch[2].trim();
      const desc = linkMatch[3]?.trim() || '';

      if (!groupMap.has(currentGroup)) {
        groupMap.set(currentGroup, []);
      }

      groupMap.get(currentGroup).push({
        name,
        url,
        desc,
      });
    }

    for (const [groupName, groupLinks] of groupMap.entries()) {
      groups.push({
        group: groupName,
        items: groupLinks,
      });
    }

    const normalizedId = sectionTitle
      .toLowerCase()
      .trim()
      .replace(/\s+/g, '-')
      .replace(/[^\p{L}\p{N}-]/gu, '');

    sections.push({
      title: sectionTitle,
      icon: sectionIcon,
      order: sectionOrder,
      id: normalizedId || `section-${sections.length + 1}`,
      groups,
    });
  }

  sections.sort((a, b) => a.order - b.order);
} catch (error) {
  console.error('读取导航文件失败:', error);
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta
      name="theme-color"
      content="#f8fafd"
    />

    <meta
      name="description"
      content="Bunny 的工具箱与网址导航"
    />

    <title>Bunny的工具箱</title>

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="nav-app">
      <header class="app-bar">
        <div class="app-bar-inner">
          <div class="brand">
            <span
              class="app-icon"
              aria-hidden="true"
            >
              😋
            </span>

            <div class="brand-text">
              <h1 class="app-title">Tami的工具箱</h1>
              <p class="app-subtitle">我的收藏：）</p>
            </div>
          </div>

          <span class="total-chip">
            {sections.reduce(
              (sectionTotal, section) =>
                sectionTotal +
                section.groups.reduce(
                  (groupTotal, group) => groupTotal + group.items.length,
                  0,
                ),
              0,
            )}
            个链接
          </span>
        </div>
      </header>

      <div class="app-body">
        {
          sections.length > 0 && (
            <aside
              class="sidebar"
              aria-label="页面导航"
            >
              <nav class="sidebar-nav">
                {sections.map((section, index) => (
                  <a
                    href={`#${section.id}`}
                    class:list={[
                      'sidebar-link',
                      {
                        active: index === 0,
                      },
                    ]}
                    data-section-id={section.id}
                  >
                    <span
                      class="sidebar-state-layer"
                      aria-hidden="true"
                    />

                    <span
                      class="sidebar-icon"
                      aria-hidden="true"
                    >
                      {section.icon}
                    </span>

                    <span class="sidebar-label">{section.title}</span>

                    <span class="sidebar-badge">
                      {section.groups.reduce(
                        (total, group) => total + group.items.length,
                        0,
                      )}
                    </span>
                  </a>
                ))}
              </nav>
            </aside>
          )
        }

        <main class="main-content">
          <div class="container">
            {
              sections.length === 0 ? (
                <div class="empty-state">
                  <div
                    class="empty-icon-wrapper"
                    aria-hidden="true"
                  >
                    <span class="empty-icon">📂</span>
                  </div>

                  <h2>这里暂时空空的</h2>

                  <p>添加 Markdown 文件后，导航内容就会出现在这里。</p>

                  <code>src/content/nav/</code>
                </div>
              ) : (
                <div class="sections-grid">
                  {sections.map((section, sectionIndex) => {
                    const totalLinks = section.groups.reduce(
                      (total, group) => total + group.items.length,
                      0,
                    );

                    return (
                      <section
                        class="section-card"
                        id={section.id}
                        style={`--section-index: ${sectionIndex}`}
                      >
                        <div class="section-header">
                          <div class="section-header-left">
                            <div
                              class="section-icon-wrapper"
                              aria-hidden="true"
                            >
                              <span class="section-icon">{section.icon}</span>
                            </div>

                            <div class="section-heading">
                              <h2>{section.title}</h2>

                              <span class="section-description">
                                {section.groups.length} 个分组
                              </span>
                            </div>
                          </div>

                          <span class="chip">{totalLinks}</span>
                        </div>

                        <div class="groups">
                          {section.groups.map((group, groupIndex) => (
                            <section
                              class="group"
                              style={`--group-index: ${groupIndex}`}
                            >
                              <header class="group-header">
                                <span
                                  class="group-icon"
                                  aria-hidden="true"
                                >
                                  <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                  >
                                    <path
                                      d="M9 6L15 12L9 18"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </svg>
                                </span>

                                <h3 class="group-name">{group.group}</h3>

                                <span class="group-count">
                                  {group.items.length}
                                </span>
                              </header>

                              <div class="links-grid">
                                {group.items.map((link, linkIndex) => {
                                  let hostname = '';

                                  try {
                                    hostname = new URL(link.url).hostname.replace(
                                      /^www\./,
                                      '',
                                    );
                                  } catch {
                                    hostname = link.url;
                                  }

                                  return (
                                    <a
                                      href={link.url}
                                      class="link-card"
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      style={`--link-index: ${linkIndex}`}
                                    >
                                      <span
                                        class="link-state-layer"
                                        aria-hidden="true"
                                      />

                                      <span class="link-content">
                                        <span class="link-top-row">
                                          <span class="link-name">
                                            {link.name}
                                          </span>

                                          <span
                                            class="external-icon"
                                            aria-hidden="true"
                                          >
                                            <svg
                                              viewBox="0 0 24 24"
                                              fill="none"
                                            >
                                              <path
                                                d="M14 5H19V10"
                                                stroke="currentColor"
                                                stroke-width="1.8"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                              />

                                              <path
                                                d="M19 5L11 13"
                                                stroke="currentColor"
                                                stroke-width="1.8"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                              />

                                              <path
                                                d="M19 14V18C19 18.5523 18.5523 19 18 19H6C5.44772 19 5 18.5523 5 18V6C5 5.44772 5.44772 5 6 5H10"
                                                stroke="currentColor"
                                                stroke-width="1.8"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                              />
                                            </svg>
                                          </span>
                                        </span>

                                        <span class="link-url">
                                          {hostname}
                                        </span>

                                        {link.desc && (
                                          <span class="link-desc">
                                            {link.desc}
                                          </span>
                                        )}
                                      </span>
                                    </a>
                                  );
                                })}
                              </div>
                            </section>
                          ))}
                        </div>
                      </section>
                    );
                  })}
                </div>
              )
            }
          </div>
        </main>
      </div>
    </div>

    <script>
      const sidebarLinks = Array.from(
        document.querySelectorAll('.sidebar-link'),
      );

      const sectionElements = sidebarLinks
        .map((link) => {
          const sectionId = link.getAttribute('data-section-id');

          if (!sectionId) return null;

          const section = document.getElementById(sectionId);

          if (!section) return null;

          return {
            link,
            section,
          };
        })
        .filter(Boolean);

      const setActiveLink = (activeLink) => {
        sidebarLinks.forEach((link) => {
          link.classList.toggle('active', link === activeLink);
        });

        if (window.innerWidth <= 860) {
          activeLink.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center',
          });
        }
      };

      if (sectionElements.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visibleEntries = entries
              .filter((entry) => entry.isIntersecting)
              .sort(
                (first, second) =>
                  Math.abs(first.boundingClientRect.top) -
                  Math.abs(second.boundingClientRect.top),
              );

            const currentEntry = visibleEntries[0];

            if (!currentEntry) return;

            const currentItem = sectionElements.find(
              (item) => item.section === currentEntry.target,
            );

            if (currentItem) {
              setActiveLink(currentItem.link);
            }
          },
          {
            rootMargin: '-15% 0px -65% 0px',
            threshold: [0, 0.1, 0.3],
          },
        );

        sectionElements.forEach((item) => {
          observer.observe(item.section);
        });
      }

      sidebarLinks.forEach((link) => {
        link.addEventListener('click', () => {
          setActiveLink(link);
        });
      });

      const rippleElements = document.querySelectorAll(
        '.link-card, .sidebar-link',
      );

      rippleElements.forEach((element) => {
        element.addEventListener('pointerdown', (event) => {
          const currentElement = event.currentTarget;

          if (!(currentElement instanceof HTMLElement)) return;

          const rect = currentElement.getBoundingClientRect();
          const ripple = document.createElement('span');

          const size = Math.max(rect.width, rect.height) * 1.6;
          const x = event.clientX - rect.left - size / 2;
          const y = event.clientY - rect.top - size / 2;

          ripple.className = 'material-ripple';
          ripple.style.width = `${size}px`;
          ripple.style.height = `${size}px`;
          ripple.style.left = `${x}px`;
          ripple.style.top = `${y}px`;

          currentElement.appendChild(ripple);

          ripple.addEventListener(
            'animationend',
            () => {
              ripple.remove();
            },
            {
              once: true,
            },
          );
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;

    --md-primary: #0b57d0;
    --md-primary-hover: #0842a0;
    --md-primary-pressed: #062e6f;

    --md-primary-container: #d3e3fd;
    --md-primary-container-hover: #c2d7f8;
    --md-on-primary-container: #041e49;

    --md-secondary-container: #e9eef6;
    --md-on-secondary-container: #1f1f1f;

    --md-surface: #ffffff;
    --md-surface-dim: #d9d9d9;
    --md-surface-bright: #ffffff;

    --md-surface-container-lowest: #ffffff;
    --md-surface-container-low: #f8fafd;
    --md-surface-container: #f0f4f9;
    --md-surface-container-high: #e9eef6;
    --md-surface-container-highest: #dde3ea;

    --md-on-surface: #1f1f1f;
    --md-on-surface-variant: #444746;

    --md-outline: #747775;
    --md-outline-variant: #c4c7c5;

    --md-blue-50: #e8f0fe;
    --md-blue-100: #d2e3fc;
    --md-blue-200: #aecbfa;
    --md-blue-300: #8ab4f8;
    --md-blue-400: #669df6;
    --md-blue-500: #4285f4;
    --md-blue-600: #1a73e8;
    --md-blue-700: #1967d2;
    --md-blue-800: #185abc;
    --md-blue-900: #174ea6;

    --md-shadow-1:
      0 1px 2px rgba(60, 64, 67, 0.15),
      0 1px 3px 1px rgba(60, 64, 67, 0.08);

    --md-shadow-2:
      0 1px 2px rgba(60, 64, 67, 0.18),
      0 2px 6px 2px rgba(60, 64, 67, 0.1);

    --md-shadow-3:
      0 2px 4px rgba(60, 64, 67, 0.18),
      0 4px 12px 3px rgba(60, 64, 67, 0.12);

    --md-motion-standard: cubic-bezier(0.2, 0, 0, 1);
    --md-motion-emphasized: cubic-bezier(0.05, 0.7, 0.1, 1);
    --md-motion-decelerated: cubic-bezier(0, 0, 0, 1);

    --app-bar-height: 72px;
    --content-width: 1440px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--app-bar-height) + 24px);
    background: var(--md-surface-container-low);
  }

  body {
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;

    color: var(--md-on-surface);
    background:
      radial-gradient(
        circle at 12% 2%,
        rgba(66, 133, 244, 0.09),
        transparent 26rem
      ),
      radial-gradient(
        circle at 92% 12%,
        rgba(26, 115, 232, 0.06),
        transparent 30rem
      ),
      var(--md-surface-container-low);

    font-family:
      'Inter',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      'Noto Sans SC',
      'Microsoft YaHei',
      sans-serif;

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  a:focus-visible {
    outline: 3px solid rgba(11, 87, 208, 0.35);
    outline-offset: 2px;
  }

  .nav-app {
    min-height: 100vh;
    animation: app-enter 500ms var(--md-motion-decelerated) both;
  }

  /* ============================================================
     顶部 App Bar
     ============================================================ */

  .app-bar {
    position: sticky;
    top: 0;
    z-index: 100;

    height: var(--app-bar-height);
    padding: 0 24px;

    display: flex;
    align-items: center;

    background: rgba(248, 250, 253, 0.88);
    border-bottom: 1px solid rgba(196, 199, 197, 0.65);

    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
  }

  .app-bar-inner {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    min-width: 0;

    display: flex;
    align-items: center;
    gap: 14px;
  }

  .app-icon {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;

    display: grid;
    place-items: center;

    font-size: 21px;

    background: var(--md-primary-container);
    border-radius: 14px;

    box-shadow: inset 0 0 0 1px rgba(11, 87, 208, 0.08);

    animation: icon-enter 620ms var(--md-motion-emphasized) both;
  }

  .brand-text {
    min-width: 0;
  }

  .app-title {
    margin: 0;

    color: var(--md-on-surface);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .app-subtitle {
    margin: 3px 0 0;

    color: var(--md-on-surface-variant);
    font-size: 12px;
    line-height: 1.3;
  }

  .total-chip {
    flex: 0 0 auto;

    padding: 8px 14px;

    color: var(--md-primary);
    background: var(--md-primary-container);

    border-radius: 999px;

    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.01em;

    animation: chip-enter 500ms 80ms var(--md-motion-emphasized) both;
  }

  /* ============================================================
     页面布局
     ============================================================ */

  .app-body {
    width: 100%;
    max-width: var(--content-width);
    min-height: calc(100vh - var(--app-bar-height));

    margin: 0 auto;
    padding: 22px 24px 56px;

    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  /* ============================================================
     左侧 Navigation Rail
     ============================================================ */

  .sidebar {
    position: sticky;
    top: calc(var(--app-bar-height) + 22px);

    flex: 0 0 220px;
    max-height: calc(100vh - var(--app-bar-height) - 44px);

    overflow-y: auto;
    overscroll-behavior: contain;

    padding: 8px;
    border-radius: 22px;

    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(196, 199, 197, 0.55);

    box-shadow: var(--md-shadow-1);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    animation: sidebar-enter 500ms 90ms var(--md-motion-emphasized) both;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sidebar-link {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    width: 100%;
    min-height: 48px;
    padding: 8px 12px;

    display: flex;
    align-items: center;
    gap: 11px;

    color: var(--md-on-surface-variant);
    text-decoration: none;

    border-radius: 16px;

    font-size: 13px;
    font-weight: 500;

    transition:
      color 180ms var(--md-motion-standard),
      background 180ms var(--md-motion-standard),
      transform 180ms var(--md-motion-standard);
  }

  .sidebar-state-layer {
    position: absolute;
    inset: 0;
    z-index: -1;

    background: currentColor;
    opacity: 0;

    transition: opacity 180ms var(--md-motion-standard);
  }

  .sidebar-link:hover .sidebar-state-layer {
    opacity: 0.07;
  }

  .sidebar-link:active {
    transform: scale(0.985);
  }

  .sidebar-link:active .sidebar-state-layer {
    opacity: 0.12;
  }

  .sidebar-link.active {
    color: var(--md-on-primary-container);
    background: var(--md-primary-container);
    font-weight: 600;
  }

  .sidebar-link.active:hover {
    background: var(--md-primary-container-hover);
  }

  .sidebar-icon {
    width: 26px;
    height: 26px;
    flex: 0 0 26px;

    display: grid;
    place-items: center;

    font-size: 15px;

    border-radius: 9px;

    transition:
      transform 250ms var(--md-motion-emphasized),
      background 200ms var(--md-motion-standard);
  }

  .sidebar-link:hover .sidebar-icon {
    transform: scale(1.08) rotate(-3deg);
  }

  .sidebar-link.active .sidebar-icon {
    background: rgba(255, 255, 255, 0.48);
  }

  .sidebar-label {
    flex: 1;
    min-width: 0;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-badge {
    min-width: 24px;
    height: 22px;
    padding: 0 7px;
    flex: 0 0 auto;

    display: grid;
    place-items: center;

    color: var(--md-on-surface-variant);
    background: var(--md-surface-container);

    border-radius: 999px;

    font-size: 10px;
    font-weight: 600;

    transition:
      color 180ms var(--md-motion-standard),
      background 180ms var(--md-motion-standard);
  }

  .sidebar-link.active .sidebar-badge {
    color: var(--md-primary);
    background: rgba(255, 255, 255, 0.6);
  }

  /* ============================================================
     主内容
     ============================================================ */

  .main-content {
    flex: 1;
    min-width: 0;
  }

  .container {
    width: 100%;
  }

  .sections-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ============================================================
     大分类卡片
     ============================================================ */

  .section-card {
    position: relative;
    scroll-margin-top: calc(var(--app-bar-height) + 22px);

    padding: 22px;

    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(196, 199, 197, 0.62);
    border-radius: 24px;

    box-shadow: var(--md-shadow-1);

    transition:
      box-shadow 280ms var(--md-motion-standard),
      border-color 280ms var(--md-motion-standard),
      transform 280ms var(--md-motion-standard);

    animation: section-enter 550ms
      calc(100ms + var(--section-index) * 70ms)
      var(--md-motion-emphasized)
      both;
  }

  .section-card::before {
    content: '';

    position: absolute;
    inset: 0;
    z-index: -1;

    border-radius: inherit;

    background: linear-gradient(
      135deg,
      rgba(66, 133, 244, 0.07),
      transparent 32%
    );

    opacity: 0;

    transition: opacity 300ms var(--md-motion-standard);
  }

  .section-card:hover {
    border-color: rgba(11, 87, 208, 0.24);
    box-shadow: var(--md-shadow-2);
    transform: translateY(-2px);
  }

  .section-card:hover::before {
    opacity: 1;
  }

  .section-header {
    margin-bottom: 18px;
    padding-bottom: 17px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    border-bottom: 1px solid rgba(196, 199, 197, 0.58);
  }

  .section-header-left {
    min-width: 0;

    display: flex;
    align-items: center;
    gap: 13px;
