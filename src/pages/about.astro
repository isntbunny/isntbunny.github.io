---
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About me",
	title: "About",
};

const contacts = [
	{ icon: "mdi:github", label: "GitHub", url: "https://github.com/isntbunny" },
	{ icon: "mdi:web", label: "Status", url: "https://status.cafe/users/isntbunny" },
];

const aboutEntry = await getEntry("page", "about");
if (!aboutEntry) throw new Error("Missing src/content/page/about.md");
const { Content } = await render(aboutEntry);
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<Content />
	</div>

	<section class="mt-10 rounded-md bg-sky-50/60 p-4 dark:bg-sky-950/40">
		<p class="mb-3 font-semibold">Find me on</p>
		<ul class="space-y-2">
			{contacts.map((item) => (
				<li>
					<a class="inline-flex items-center gap-2 hover:underline" href={item.url} target="_blank" rel="noreferrer">
						<Icon name={item.icon} class="h-5 w-5" />
						<span>{item.label}</span>
					</a>
				</li>
			))}
			<li class="inline-flex items-center gap-2">
				<Icon name="mdi:email-outline" class="h-5 w-5" />
				<span>Email: isntbunny@outlook.com</span>
			</li>
		</ul>
	</section>
</PageLayout>
