---
import PageLayout from "@/pages/layouts/Base.astro";
import "src/styles/pages/about.css";
import {
  stamps,
  blinkies,
  scrollImages,
  socialLinks,
  skillCategories,
} from "@/data/about-stickers";
---

<PageLayout meta={{ description: "About me", title: "About" }}>

  <div class="profile-header">
    <div class="profile-photo">
      <img src="https://i.postimg.cc/HxG7bTwc/avatar250806.png" alt="profile photo" />
    </div>
    <div class="header-info">
      <h1 class="myname">Hi, I'm Eucaly</h1>
      <p class="mybio">小透明高中生/术力口厨/oc人</p>
      <div class="attribar">
        <img src="https://i.postimg.cc/cL2S3sYZ/female.gif" alt="female" />
        <img src="https://i.postimg.cc/1tZ1WJJw/Chinese.png" alt="Chinese" />
        <img src="https://i.postimg.cc/wvdYW00t/nerd.gif" alt="nerd" />
        <img src="https://i.postimg.cc/s2WR9t9B/geek.gif" alt="geek" />
        <img src="https://i.postimg.cc/BvFGcd5d/freespeech.gif" alt="freespeech" />
        <img src="https://i.postimg.cc/1zFZcLc3/fucknazis.gif" alt="fucknazis" />
      </div>
    </div>
  </div>

  <div class="">
    <h2>GET TO KNOW ME!</h2>
    <div class="sticker-fufu"><a href="https://postimg.cc/qh4kVGs2" target="_blank"><img src="https://i.postimg.cc/qh4kVGs2/fufu-miku.png" alt="fufu-miku"></a></div>
				
        <div class="my-hobbies">
          <h3>I love...</h3>
          <img src="https://i.postimg.cc/k4dPjffc/Programming.png" alt="Programming" />
          <img src="https://i.postimg.cc/DZK3CBBD/Drawing.png" alt="Drawing" />
          <img src="https://i.postimg.cc/TwqMBgsM/Animes.png" alt="Animes" />
        </div>
        <div class="sociallinks">
          <h3>contact me</h3>
          {socialLinks.map(({ name, url, img }) => (
            <a key={name} href={url}>
              <img src={img} alt={name} />
            </a>
          ))}
        </div>
        <div class="stamps">
          <h3>Stamps</h3>
          <div class="stamppic">
            {stamps.map((src, i) => (
              <img key={i} src={src} alt={`stamp-${i}`} />
            ))}
          </div>
         </div>
    </div>
  
  <div class="scroll-container">
    <div class="scroll-track blinkies">
          {blinkies.map((src, i) => (
            <img key={i} src={src} alt={`blinkie-${i}`} />
          ))}
    </div>
  </div>
  <a href="https://postimages.org/" target="_blank"><img src="https://i.postimg.cc/c4cCf84W/01.png" alt="01"></a>
  <div class="">
    <h2>MY SKILLS</h2>
    <ul>
      {skillCategories.map((category) => (
        <div key={category.title}>
          <h3>{category.title}</h3>
          {category.items.map((item, i) => {
            if (typeof item === "string") {
              return <li key={i}>{item}</li>;
            }
            return <img key={i} src={item.icon} alt={item.name} height="25px" />;
          })}
        </div>
      ))}
    </ul>
  </div>
<a href="https://postimages.org/" target="_blank"><img src="https://i.postimg.cc/c4cCf84W/01.png" alt="01"></a>
  <div class="poid">
    <h2>IDEOLOGY</h2>
    <div>
      <p>自由意志社会主义desu</p>
      <img src="https://i.postimg.cc/BZpfg5DS/9axes.jpg" alt="9axes" />
    </div>
  </div>

    <div class="scroll-container">
        <div class="scroll-track buttons">
              {[...scrollImages, ...scrollImages].map((src, i) => (
                      <img key={i} src={src} alt={`scroll-${i}`} />
                            ))}
                                </div>
                                  </div>
</PageLayout>