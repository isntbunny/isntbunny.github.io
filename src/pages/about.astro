---
import PageLayout from "@/layouts/Base.astro";
import "src/styles/pages/about.css";
import {
  stamps,
  blinkies,
  scrollImages,
  skillCategories,
} from "@/data/about-stickers";
---

<PageLayout meta={{ description: "About me", title: "About" }}>

  <div class="about-grid">

    <!-- ===== 个人资料 ===== -->
    <div class="profile-header">
      <div class="profile-photo">
        <img src="https://i.postimg.cc/HxG7bTwc/avatar250806.png" alt="profile photo" />
      </div>
      <div>
    <h1>The Webmaster</h1>
        <div class="attribar">
          <img src="https://i.postimg.cc/cL2S3sYZ/female.gif" alt="female" />
          <img src="https://i.postimg.cc/1tZ1WJJw/Chinese.png" alt="Chinese" />
          <img src="https://i.postimg.cc/wvdYW00t/nerd.gif" alt="nerd" />
          <img src="https://i.postimg.cc/s2WR9t9B/geek.gif" alt="geek" />
          <img src="https://i.postimg.cc/BvFGcd5d/freespeech.gif" alt="freespeech" />
          <img src="https://i.postimg.cc/1zFZcLc3/fucknazis.gif" alt="fucknazis" />
        </div>
      </div>
    <div> I'm Takotami, a slashie who always have passion in interesting things, expressing myself. You can call me <a href="https://pronoun.cc/isntbunny">Tami</a></div>
    </div>

    <!-- ===== 爱好 ===== -->
    <div class="card hobbies-card">
      <h2>Interests</h2>
      <div class="hobby-tags">
        <span class="hobby-tag">drawing</span>
        <span class="hobby-tag">singing</span>
        <span class="hobby-tag">anime</span>
        <span class="hobby-tag">programming</span>
      </div>
    </div>

    <!-- ===== 社交 ===== -->
    <div class="card social-card">
      <h2>Contact Me</h2>
      <div class="social-icons">
        <li>isntbunny@outlook.com</li>
        <li>Matrix: hensuuerror:catgirl.org</li>
      </div>
    </div>

    <!-- ===== 印章 ===== -->
    <div class="card card-full">
      <h2>Stamps</h2>
      <div class="stamppic">
        {stamps.map((src, i) => (
          <img key={i} src={src} alt={`stamp-${i}`} />
        ))}
      </div>
    </div>

    <!-- ===== 滚动 LED ===== -->
    <div class="scroll-card card-full">
      <div class="scroll-container">
        <div class="scroll-track">
          {[...blinkies, ...blinkies].map((src, i) => (
            <img key={i} src={src} alt={`blinkie-${i}`} />
          ))}
        </div>
      </div>
    </div>

    <!-- ===== 技能 ===== -->
    <div class="card card-full">
      <h2>My Skills</h2>
      <div class="skills-grid">
        {skillCategories.map((category) => (
          <div key={category.title} class="skill-group">
            <h3>{category.title}</h3>
            <ul>
              {category.items.map((item, i) => {
                if (typeof item === "string") {
                  return <li key={i}>{item}</li>;
                }
                return (
                  <li key={i} class="skill-icon-item">
                    <img src={item.icon} alt={item.name} />
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- ===== 意识形态 ===== -->
    <div class="card ideology-card">
      <h2>Ideology</h2>
      <p>自由意志社会主义 desu</p>
      <img src="https://i.postimg.cc/BZpfg5DS/9axes.jpg" alt="9axes" />
    </div>

    <!-- ===== 注射器图片分割线（仅底部） ===== -->
    <div class="divider-image card-full">
      <img src="https://i.postimg.cc/c4cCf84W/01.png" alt="divider" />
    </div>

    <!-- ===== 滚动按钮 ===== -->
    <div class="scroll-card card-full">
      <div class="scroll-container">
        <div class="scroll-track">
          {[...scrollImages, ...scrollImages].map((src, i) => (
            <img key={i} src={src} alt={`scroll-${i}`} />
          ))}
        </div>
      </div>
    </div>

  </div>

</PageLayout>