---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = (await getAllPosts()).sort(collectionDateSort);
	return paginate(allPosts, {
		pageSize: allPosts.length || 1,
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: "Posts",
};

// 只按年份分组
const grouped = page.data.reduce<Record<string, CollectionEntry<"post">[]>>(
	(acc, post) => {
		const year = String(post.data.publishDate.getFullYear());
		acc[year] ??= [];
		acc[year].push(post);
		return acc;
	},
	{},
);

const yearKeys = Object.keys(grouped).sort((a, b) => +b - +a);
---

<PageLayout meta={meta}>
	<div class="posts-page">
		{
			yearKeys.map((year, yearIndex) => (
				<section
					class="fade-stagger"
					style={`animation-delay:${yearIndex * 0.1}s`}
					data-year={year}
				>
					<h2 class="posts-year">{year}</h2>
					<ul class="posts-list">
						{grouped[year].map((post) => (
							<li class="posts-list-item">
								<a href={`/posts/${post.id}/`} class="posts-list-link">
									{post.data.title}
								</a>
								<div class="posts-meta">
									<time class="small-muted posts-date">
										{post.data.publishDate.toLocaleDateString("zh-CN", {
											month: "numeric",
											day: "numeric",
										})}
									</time>
								</div>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</PageLayout>

<style>
	@import url("@/styles/pages/posts.css");
</style>