---
import { getCollection } from 'astro:content';
import Layout from "@/layouts/Base.astro";
const  alluta = await getCollection('uta');
---

<Layout meta={{ title: '歌词本' }}>
  <h1>歌词本</h1>
  {alluta && alluta.length > 0 ? (
    <ul>
      {alluta.map(uta => (
        <li>
          <a href={`/uta/${uta.id.replace('.md', '')}`}>
            {uta.data?.title || uta.id}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p>没有找到日记文件，请确认 src/content/uta/ 下有 .md 文件</p>
  )}
</Layout>