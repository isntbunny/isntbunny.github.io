---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import "/src/styles/pages/blogpost.css";


export async function getStaticPaths() {
  // 获取所有 journals 条目
  const journalsEntries = await getCollection('journals');
  
  // 为每个条目生成路径
  return journalsEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// 从 props 中获取当前条目
const { entry } = Astro.props;

// 确保 entry 存在
if (!entry) {
  throw new Error('未找到对应的日志条目');
}

// 渲染内容
const { Content } = await entry.render();
---

<Base meta={{ title: entry.data.title }}>
    <h1>{entry.data.title}</h1>
    {entry.data.date && <time>{entry.data.date.toLocaleDateString()}</time>}
    <Content />
</Base>