---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const alljournalss = await getCollection('journals');
---

<Base meta={{ title: '日记列表' }}>
  <h1>日记列表</h1>
  <ul>
    {alljournalss.map(journals => (
      <li>
        <a href={`/journals/${journals.id.replace('.md', '')}`}>
          {journals.data.title}
        </a>
      </li>
    ))}
  </ul>
</Base>
