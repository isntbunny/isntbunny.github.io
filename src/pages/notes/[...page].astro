---
import type { GetStaticPaths } from "astro";
import { getAllNotes } from "@/data/note";

export const getStaticPaths = (async ({ paginate }) => {
	const notes = await getAllNotes();
	const pages = notes.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
	return paginate(pages, { pageSize: 10 });
}) satisfies GetStaticPaths;

return Astro.redirect(Astro.url.pathname.replace(/^\/notes\//, "/memos/"), 301);
---
