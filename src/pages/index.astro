---
import PageLayout from "@/layouts/Base.astro";
import "/src/styles/pages/index.css";
import GithubCommits from "@/components/GithubCommits.astro";
---

<PageLayout meta={{ title: "Home", description: "主页" }}>
	<!-- ===== 贴纸墙 ===== -->

	<section class="sticker-wall">
		<div class="sticker-grid">
			<div class="sticker mushroom-sticker">
				<a href="https://postimages.org/" target="_blank">
					<img src="https://i.postimg.cc/Pq05dWKQ/Amanita-cokeri.png" alt="Amanita-cokeri" />
				</a>
			</div>
			<div class="sticker mushroom-sticker">
				<a href="https://postimages.org/" target="_blank">
					<img src="https://i.postimg.cc/C1DL5RQT/Coprinus-comatus.png" alt="Coprinus-comatus" />
				</a>
			</div>
			<div class="sticker mushroom-sticker">
				<a href="https://postimages.org/" target="_blank">
					<img src="https://i.postimg.cc/RhLS1jmh/Mycena-interrupta.png" alt="Mycena-interrupta" />
				</a>
			</div>
			<div class="sticker mushroom-sticker">
				<img src="https://i.postimg.cc/Jz4nx4tS/sumikko-seedling.png" />
			</div>
		</div>
	</section>

	<!-- ===== 主网格 ===== -->
	<div class="main-grid">

		<!-- ===== 左栏 ===== -->
		<div class="left-col">

			<!-- 欢迎卡片 -->
			<section class="sitecard welcome-card">
				<h1>Welcome to my corner.</h1>
				<p>退网中，乱七八糟的布局就先搁置不改了。</p>
				<p class="badge-row">
					<a href="https://postimages.org/" target="_blank">
						<img src="https://i.postimg.cc/vZksnQnq/made-with-windows.gif" alt="made-with-windows" />
					</a>
					<a href="https://postimg.cc/JsNvVCP5" target="_blank">
						<img src="https://i.postimg.cc/JsNvVCP5/vscbutton.gif" alt="vscbutton" />
					</a>
				</p>
			</section>

			<!-- Latest Status -->
			<section class="sitecard">
				<h2>✦ Latest Status</h2>
				<p>
					now I'm 
					<a href="https://www.imood.com/users/isntbunny">
						<img src="https://moods.imood.com/display/uname-isntbunny/fg-000000/bg-ffffff/imood.gif" alt="The current mood of isntbunny at www.imood.com" border="0" />
					</a>
				</p>
				<div id="statuscafe-username"></div>
				<div id="statuscafe-content"></div>
				<script src="https://status.cafe/current-status.js?name=isntbunny" defer></script>
			</section>

			<!-- Github Commits -->
			<section class="sitecard">
				<GithubCommits />
			</section>

		</div>

		<!-- ===== 右栏 ===== -->
		<div class="right-col">

			<!-- Countdown -->
			<section class="sitecard">
				<h2>✦ Countdown</h2>
				<div class="distance-label">
					距离<select id="yearSelect" class="year-select"></select>高考还有
				</div>
				<span class="days-number" id="countdownDays">--</span>天
			</section>

			<!-- RECENTLY READING -->
			<section class="sitecard">
				<h2>✦ RECENTLY READING</h2>
				<ul class="reading-list">
					<li>红与黑</li>
					<li>Animal Farm</li>
				</ul>
			</section>

			<!-- ToDo -->
			<section class="sitecard">
				<h2>✦ ToDo</h2>
				<div class="todo-placeholder"></div>
			</section>

		</div>

	</div>

</PageLayout>

<script>
	document.addEventListener('astro:page-load', () => {
	  // 高考倒计时逻辑写在这里
	  const GAOKAO_MONTH = 6;
	  const GAOKAO_DAY = 7;
  
	  function getCurrentDate() {
		const now = new Date();
		return new Date(now.getFullYear(), now.getMonth(), now.getDate());
	  }
  
	  function getDaysToGaokao(targetYear) {
		const today = getCurrentDate();
		const gaokaoDate = new Date(targetYear, GAOKAO_MONTH - 1, GAOKAO_DAY);
		const diffTime = gaokaoDate - today;
		return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
	  }
  
	  function updateCountdown(targetYear) {
		const days = getDaysToGaokao(targetYear);
		const daysSpan = document.getElementById("countdownDays");
		if (daysSpan) {
		  daysSpan.textContent = days;
		}
	  }
  
	  function generateYearOptions() {
		const today = getCurrentDate();
		const currentYear = today.getFullYear();
		const currentGaokaoDate = new Date(currentYear, GAOKAO_MONTH - 1, GAOKAO_DAY);
  
		let startYear = currentYear;
		if (today > currentGaokaoDate) {
		  startYear = currentYear + 1;
		}
  
		const endYear = startYear + 5;
		const years = [];
		for (let y = startYear; y <= endYear; y++) {
		  years.push(y);
		}
		return years;
	  }
  
	  function initSelect() {
		const select = document.getElementById("yearSelect");
		if (!select) {
		  console.error("未找到 id 为 yearSelect 的下拉框元素");
		  return;
		}
  
		const years = generateYearOptions();
		if (years.length === 0) {
		  const emptyOpt = document.createElement("option");
		  emptyOpt.textContent = "无年份";
		  select.appendChild(emptyOpt);
		  const daysSpan = document.getElementById("countdownDays");
		  if (daysSpan) daysSpan.textContent = "--";
		  return;
		}
  
		let defaultYear = 2027;
		if (!years.includes(defaultYear)) {
		  defaultYear = years[0];
		}
  
		select.innerHTML = "";
		years.forEach((year) => {
		  const option = document.createElement("option");
		  option.value = year;
		  option.textContent = year + "年";
		  if (year === defaultYear) {
			option.selected = true;
		  }
		  select.appendChild(option);
		});
  
		const initialSelected = parseInt(select.value, 10);
		if (!isNaN(initialSelected)) {
		  updateCountdown(initialSelected);
		} else {
		  const daysSpan = document.getElementById("countdownDays");
		  if (daysSpan) daysSpan.textContent = "--";
		}
  
		const newSelect = select.cloneNode(true);
		select.parentNode.replaceChild(newSelect, select);
		
		newSelect.addEventListener("change", function (e) {
		  const selectedYear = parseInt(e.target.value, 10);
		  if (!isNaN(selectedYear)) {
			updateCountdown(selectedYear);
		  } else {
			const daysSpan = document.getElementById("countdownDays");
			if (daysSpan) daysSpan.textContent = "--";
		  }
		});
	  }
  
	  initSelect();
	});
</script>