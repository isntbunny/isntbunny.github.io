---
import PageLayout from "@/layouts/Base.astro";
import "/src/styles/pages/index.css";
import StatusBubble from "@/components/StatusBubble.astro";
import Window from "@/components/Window.astro"; 
---

<PageLayout meta={{ title: "Home", description: "主页" }}>
  
  <!-- ===== 主网格 ===== -->
  <div class="main-grid">
	<div class="home-sticker">
		
	</div>
    <div class="left-col">
    <div>
      <div class="distance-label">
          距离<select id="yearSelect" class="year-select"></select>高考还有
      </div>
        <span class="days-number" id="countdownDays">--</span>天
    </div>

    <div class="photo">

  </div>

    <Window title="Fanlistings">
      <img src="http://fan.after-death.org/magica/codes/50x50_08.png">
    </Window>

	</div>
    <div class="middle-col">

      <!-- ===== 欢迎卡片（使用Window组件） ===== -->
        <Window title="Welcome">
        <div class="sticker-snowfufu">
          <a href="https://postimg.cc/nj2nHQ2N" target="_blank">
            <img src="https://i.postimg.cc/nj2nHQ2N/fufu-snow.png" alt="fufu-snow">
          </a>
        </div>
        <p>Hellllloooo, I'm Eucaly. Welcome to my nook! This a place where I document my dairy and thoughts.</p>
        <div class="bow-divider"></div>
        <p class="badge-row">
          <a href="https://postimages.org/" target="_blank">
            <img src="https://i.postimg.cc/vZksnQnq/made-with-windows.gif" alt="made-with-windows" />
          </a>
          <a href="https://postimg.cc/JsNvVCP5" target="_blank">
            <img src="https://i.postimg.cc/JsNvVCP5/vscbutton.gif" alt="vscbutton" />
          </a>

        </p>
        </Window>

        <Window title="Latest Status" class="status-window">
        <StatusBubble />
        </Window>


    </div>

    <!-- ===== 右栏 ===== -->
    <div class="right-col">
      
      <Window title="FriendLinks">
        <div class="friendlinks">
          <li><a href="https://moyuxiaozhan.mysxl.cn">摸鱼小站</a></li>
          <li><a href="https://youtube.com/@07Stinky/">07Stinky</a></li>
          <li><a href="https://sutdown.github.io/">Sutdown</a></li>
          <li><a href="https://github.com/8989denis">Denis</a></li>
        </div>
      </Window>

      <Window title="Webrings">
<map name="onlinewidget">
<area href="https://webring.ghostk.id/online/" target="_blank" shape="rect" coords="20,14,167,24" alt="The online webring" title="The online webring">
<area href="https://webring.ghostk.id/online/isntbunny/previous" target="_top" shape="rect" coords="7,27,60,36" alt="Previous" title="Previous">
<area href="https://webring.ghostk.id/online/random" target="_top" shape="rect" coords="74,27,126,36" alt="Random" title="Random">
<area href="https://webring.ghostk.id/online/isntbunny/next" target="_top" shape="rect" coords="139,27,192,36" alt="Next" title="Next">
</map>
<img usemap="#onlinewidget" src="https://ghostk.id/i/onlinegray.gif" width="200" height="40" style="width:200px;height:40px;max-width:none;image-rendering:pixelated;" alt="A Windows style dialog box titled 'THE ONLINE WEBRING' with three clickable buttons labeled Previous, Random, and Next">

      </Window>

      <Window title="Guestbook" class="guest" >
        <iframe
          src="https://www3.cbox.ws/box/?boxid=3552712&boxtag=FGVbRe"
          width="100%"
          height="450"
          allowtransparency="yes"
          allow="autoplay"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          scrolling="auto"
        >
        </iframe>
      </Window>


    </div>

  </div>

</PageLayout>

<script>
import { initCountdown } from '@/utils/countdown';
	    
document.addEventListener('astro:page-load', () => {
	initCountdown();
});


</script>
