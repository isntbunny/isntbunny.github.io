---
import PageLayout from "@/layouts/Base.astro";
import "/src/styles/pages/index.css";
import GithubCommits from "@/components/GithubCommits.astro";
import Window from "@/components/Window.astro";  // 新增的Window组件
---

<PageLayout meta={{ title: "Home", description: "主页" }}>
  
  <!-- ===== 主网格 ===== -->
  <div class="main-grid">
    <!-- ===== 左栏 ===== -->
    <div class="left-col">

      <!-- ===== 欢迎卡片（使用Window组件） ===== -->
      <Window title="Welcome">
        <div class="sticker-snowfufu">
          <a href="https://postimg.cc/nj2nHQ2N" target="_blank">
            <img src="https://i.postimg.cc/nj2nHQ2N/fufu-snow.png" alt="fufu-snow">
          </a>
        </div>
        <h1>「幸せのカウントダウン」</h1>
        <p>Hellllloooo, I'm Bunny. Welcome to my nook! This a place where I document my dairy and thoughts.</p>
        <p id="greeting-text">idntifying ur ip...</p>
        <p id="extra-text" class="welcome-extra"></p>
        <p id="ip-text" class="welcome-ip"></p>
        <p class="badge-row">
          <a href="https://postimages.org/" target="_blank">
            <img src="https://i.postimg.cc/vZksnQnq/made-with-windows.gif" alt="made-with-windows" />
          </a>
          <a href="https://postimg.cc/JsNvVCP5" target="_blank">
            <img src="https://i.postimg.cc/JsNvVCP5/vscbutton.gif" alt="vscbutton" />
          </a>
        </p>
        <slot />
      </Window>

      <!-- ===== Latest Status（使用Window组件） ===== -->
      <Window title="✦ Latest Status ✦">
        <p>乱七八糟的布局.jpg 个人与画廊页面仍在施工中(^._.^)ﾉ</p>
        <p>
          now I'm 
          <a href="https://www.imood.com/users/isntbunny">
            <img src="https://moods.imood.com/display/uname-isntbunny/fg-000000/bg-ffffff/imood.gif" alt="The current mood of isntbunny at www.imood.com" border="0" />
          </a>
        </p>
        
        <!-- ===== 重点：Bubbling-me 气泡说话小人 ===== -->
        <div class="bubbling-me">
          <a href="https://status.cafe/users/isntbunny">
            <img src='https://i.postimg.cc/9MLD69pb/Gif260720.gif' border='0' alt='Gif260720' />
          </a>
          <div class="bub-outer">
            <div class="bub" id="statusBubble" style="cursor: pointer;">
              <div id="statuscafe-content">最近好像没有什么可说的呢....让我想想。</div>
            </div>
            <!-- 刷新按钮 -->
            <button id="refreshStatusBtn" class="refresh-btn" title="换一条状态">
              How are you？
            </button>
            <div id="statuscafe-username" style="text-align: end; border-top: 2px dotted var(--angel-blue); padding-top: 3px;">thinking</div>
          </div>
        </div>
        
        <div class="bow-divider"></div>
        <h3>What Am I Reading</h3>
        <ul class="reading-list">
          <li>红与黑</li>
          <li>Animal Farm</li>
        </ul>
      </Window>

      <!-- ===== GithubCommits（使用Window组件） ===== -->
      <Window title="GitHub 动态">
        <GithubCommits />
      </Window>

    </div>

    <!-- ===== 右栏 ===== -->
    <div class="right-col">

      <!-- ===== Countdown（使用Window组件） ===== -->
      <Window title="✦ Countdown ✦">
        <div class="distance-label">
          距离<select id="yearSelect" class="year-select"></select>高考还有
        </div>
        <span class="days-number" id="countdownDays">--</span>天
      </Window>

      <!-- ===== ToDo（使用Window组件） ===== -->
      <Window title="✦ ToDo ✦">
        <div class="todo-placeholder"></div>
      </Window>

      <!-- ===== Guestbook（使用Window组件） ===== -->
      <Window title="✦ Guestbook ✦">
        <iframe
          src="https://www3.cbox.ws/box/?boxid=3552712&boxtag=FGVbRe"
          width="100%"
          height="450"
          allowtransparency="yes"
          allow="autoplay"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          scrolling="auto"
        >
        </iframe>
      </Window>

    </div>

  </div>

</PageLayout>

<script>
import { initVisitorInfo } from '@/utils/visitor-info';
import { initCountdown } from '@/utils/countdown';
import { customMessages } from '@/data/custom-messages';
	    
document.addEventListener('astro:page-load', () => {
	initVisitorInfo();
	initCountdown();
	initStatusSwitcher();
});

function initStatusSwitcher() {
	const refreshBtn = document.getElementById('refreshStatusBtn');
	const statusContent = document.getElementById('statuscafe-content');
	const usernameEl = document.getElementById('statuscafe-username');
	
	let statusList = [];
	let allMessages = [];
	let currentIndex = -1;
	let isLoading = false;
	let isTyping = false;
	
	// 从 status.cafe 读取所有状态
	async function fetchAllStatuses() {
		try {
			const response = await fetch('https://status.cafe/users/isntbunny.atom');
			const text = await response.text();
			const parser = new DOMParser();
			const xml = parser.parseFromString(text, 'text/xml');
			const entries = xml.querySelectorAll('entry');
			
			const messages = [];
			entries.forEach((entry) => {
				const content = entry.querySelector('content')?.textContent;
				const title = entry.querySelector('title')?.textContent;
				const message = content || title;
				
				const published = entry.querySelector('published')?.textContent;
				let timeAgo = '';
				if (published) {
					const date = new Date(published);
					const now = new Date();
					const diffMs = now - date;
					const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
					
					if (diffDays === 0) {
						const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
						if (diffHours === 0) {
							const diffMins = Math.floor(diffMs / (1000 * 60));
							timeAgo = diffMins <= 1 ? '刚刚' : `${diffMins} 分钟前`;
						} else {
							timeAgo = `${diffHours} 小时前`;
						}
					} else if (diffDays === 1) {
						timeAgo = '昨天';
					} else {
						timeAgo = `${diffDays} 天前`;
					}
				}
				
				if (message && message.trim()) {
					const cleanMsg = message.trim();
					if (cleanMsg.length > 0) {
						messages.push({
							text: cleanMsg,
							time: timeAgo,
							date: published
						});
					}
				}
			});
			
			return messages;
		} catch (error) {
			console.error('读取状态失败:', error);
			return [];
		}
	}
	
	// 合并所有消息
	function mergeMessages(statusMessages) {
		const merged = [];
		
		statusMessages.forEach(msg => {
			merged.push({ 
				type: 'status', 
				text: msg.text,
				time: msg.time,
				date: msg.date
			});
		});
		
		const shuffled = [...customMessages].sort(() => Math.random() - 0.5);
		shuffled.forEach(msg => {
			merged.push({ 
				type: 'custom', 
				text: msg,
				time: '',
				date: null
			});
		});
		
		return merged.sort(() => Math.random() - 0.5);
	}
	
	// 检查内容是否溢出
	function isOverflowing(element) {
		return element.scrollHeight > element.clientHeight;
	}
	
	// 调整居中状态
	function updateAlignment(element) {
		if (isOverflowing(element)) {
			element.style.alignItems = 'flex-start';
			element.style.justifyContent = 'flex-start';
			element.scrollTop = element.scrollHeight;
		} else {
			element.style.alignItems = 'center';
			element.style.justifyContent = 'center';
			element.scrollTop = 0;
		}
	}
	
	// 强制滚动到底部（用于打字时）
	function scrollToBottom() {
		statusContent.scrollTop = statusContent.scrollHeight;
		const bub = statusContent.closest('.bub');
		if (bub && bub.scrollHeight > bub.clientHeight) {
			bub.scrollTop = bub.scrollHeight;
		}
	}
	
	// 打字机效果
	function typeText(element, text, speed = 89) {
		return new Promise((resolve) => {
			if (isTyping) {
				resolve();
				return;
			}
			isTyping = true;
			
			let index = 0;
			element.textContent = '';
			element.scrollTop = 0;
			element.style.alignItems = 'center';
			element.style.justifyContent = 'center';
			
			function typeChar() {
				if (index < text.length) {
					element.textContent += text.charAt(index);
					index++;
					
					updateAlignment(element);
					if (isOverflowing(element)) {
						element.scrollTop = element.scrollHeight;
					}
					
					const delay = speed + Math.random() * 15;
					setTimeout(typeChar, delay);
				} else {
					isTyping = false;
					updateAlignment(element);
					if (isOverflowing(element)) {
						element.scrollTop = element.scrollHeight;
					}
					resolve();
				}
			}
			
			typeChar();
		});
	}
	
	// 显示指定索引的消息
	async function showMessage(index) {
		if (!allMessages.length || index < 0 || index >= allMessages.length) {
			return;
		}
		
		if (isTyping) {
			return;
		}
		
		const msg = allMessages[index];
		
		statusContent.textContent = '';
		await typeText(statusContent, msg.text, 89);
		
		if (usernameEl) {
			if (msg.type === 'status' && msg.time) {
				usernameEl.textContent = `📅 ${msg.time}`;
			} else if (msg.type === 'custom') {
				usernameEl.textContent = '剛剛';
			} else {
				usernameEl.textContent = 'thinking';
			}
		}
	}
	
	// 切换到下一条
	async function nextStatus() {
		if (isLoading || isTyping) return;
		
		if (allMessages.length === 0) {
			isLoading = true;
			statusContent.textContent = '讓Bunny想一想...';
			
			const statusMessages = await fetchAllStatuses();
			allMessages = mergeMessages(statusMessages);
			currentIndex = -1;
			isLoading = false;
			
			if (allMessages.length === 0) {
				statusContent.textContent = '不知道humm';
				if (usernameEl) {
					usernameEl.textContent = '放棄思考';
				}
				return;
			}
		}
		
		currentIndex = (currentIndex + 1) % allMessages.length;
		await showMessage(currentIndex);
	}
	
	// 点击按钮切换
	if (refreshBtn) {
		refreshBtn.addEventListener('click', nextStatus);
	}
	
	// 点击气泡切换
	const bubble = document.getElementById('statusBubble');
	if (bubble) {
		bubble.addEventListener('click', nextStatus);
	}
	
	// 页面加载后自动加载第一条
	setTimeout(async () => {
		const statusMessages = await fetchAllStatuses();
		allMessages = mergeMessages(statusMessages);
		if (allMessages.length > 0) {
			currentIndex = 0;
			await showMessage(0);
		}
	}, 1500);
}
</script>