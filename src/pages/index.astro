---
import PageLayout from "@/layouts/Base.astro";
import "/src/styles/pages/index.css";
import GithubCommits from "@/components/GithubCommits.astro";
---

<PageLayout meta={{ title: "Home", description: "主页" }}>
	
	<div class="sticker-snowfufu">
	<img src="https://i.postimg.cc/Y0K0z6W2/fufu-snow.png" alt="fufu-snow">
	</div>
	<!-- ===== 主网格 ===== -->
	<div class="main-grid">
		<!-- ===== 左栏 ===== -->
		<div class="left-col">

			<!-- 欢迎卡片 -->
			<div class="window">
				<div class="window-titlebar">
				  <div class="window-controls">
					<span class="dot close"></span>
					<span class="dot minimize"></span>
					<span class="dot maximize"></span>
				  </div>
				  <span class="window-title">Welcome</span>
				</div>
				<div class="window-content">
				  <h1>「幸せのカウントダウン」</h1>
				  <p>Hellllloooo, I'm Bunny. Welcome to my nook! This a place where I document my dairy and thoughts. </p>
				  <p id="greeting-text">idntifying ur ip...</p>
				  <p id="extra-text" class="welcome-extra"></p>
				  <p id="ip-text" class="welcome-ip"></p>
				  <p class="badge-row">
				  <a href="https://postimages.org/" target="_blank">
					<img src="https://i.postimg.cc/vZksnQnq/made-with-windows.gif" alt="made-with-windows" />
				  </a>
				  <a href="https://postimg.cc/JsNvVCP5" target="_blank">
					<img src="https://i.postimg.cc/JsNvVCP5/vscbutton.gif" alt="vscbutton" />
				  </a>
				</p>
				<slot />
				</div>
			  </div>

			<!-- Latest Status -->
			<section class="sitecard">
				<h2>✦ Latest Status ✦</h2>
				<p></p>乱七八糟的布局.jpg 个人与画廊页面仍在施工中(^._.^)ﾉ</p>
				<p>
					now I'm 
					<a href="https://www.imood.com/users/isntbunny">
						<img src="https://moods.imood.com/display/uname-isntbunny/fg-000000/bg-ffffff/imood.gif" alt="The current mood of isntbunny at www.imood.com" border="0" />
					</a>
					<div class="bubbling-me">
						<a href="https://status.cafe/users/isntbunny"><img src='https://i.postimg.cc/9MLD69pb/Gif260720.gif' border='0' alt='Gif260720'><div class="bub-outer"></a>
							<div class="bub">
							<div id="statuscafe-content">最近好像没有什么可说的呢....让我想想。</div>
									<div id="statuscafe-username" style="text-align: end; border-top: 2px dotted var(--angel-blue); 
									  padding-top: 3px;">thinking</div>
								</div>
						</div>
					</div>
					<script src="https://status.cafe/current-status.js?name=isntbunny" defer></script>
			    </div>
				<h3>What Am I Reading</h3>
				<ul class="reading-list">
					<li>红与黑</li>
					<li>Animal Farm</li>
				</ul>
			</section>
<a href="https://postimages.org/" target="_blank"><img src="https://i.postimg.cc/7LCJmwdZ/bluebow.png" alt="bluebow"></a><a href="https://postimages.org/" target="_blank"><img src="https://i.postimg.cc/7LCJmwdZ/bluebow.png" alt="bluebow"></a>
			<!-- Github Commits -->
			<section class="">
				<GithubCommits />
			</section>

		</div>

		<!-- ===== 右栏 ===== -->
		<div class="right-col">

			<!-- Countdown -->
			<section class="sitecard">
				<h2>✦ Countdown ✦</h2>
				<div class="distance-label">
					距离<select id="yearSelect" class="year-select"></select>高考还有
				</div>
				<span class="days-number" id="countdownDays">--</span>天
			</section>
			<!-- ToDo -->
			<section class="sitecard">
				<h2>✦ ToDo ✦</h2>
				<div class="todo-placeholder"></div>
			</section>
			<section class="sitecard">
				<h2>✦ Guestbook ✦</h2>
			<iframe
				src="https://www3.cbox.ws/box/?boxid=3552712&boxtag=FGVbRe"
				width="100%"
				height="450"
				allowtransparency="yes"
				allow="autoplay"
				frameborder="0"
				marginheight="0"
				marginwidth="0"
				scrolling="auto"
				>
			</iframe>
		    </section>

		</div>

	</div>

</PageLayout>

<script>
import { initVisitorInfo } from '@/utils/visitor-info';
import { initCountdown } from '@/utils/countdown';
	    
document.addEventListener('astro:page-load', () => {
	initVisitorInfo();
	initCountdown();
});
</script>