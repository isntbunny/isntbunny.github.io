---
import Search from "@/components/Search.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { menuLinks } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

const allPostsByDate = (await getAllPosts()).sort(collectionDateSort);
const latestPost = allPostsByDate[0];
const latestUpdateDays = latestPost
	? Math.max(
			0,
			Math.floor(
				(Date.now() -
					new Date(latestPost.data.updatedDate ?? latestPost.data.publishDate).getTime()) /
					(1000 * 60 * 60 * 24),
			),
		)
	: 0;

const currentYear = new Date().getFullYear();
const monthEnd = new Date(currentYear, new Date().getMonth() + 1, 0);
const nextYear = new Date(currentYear + 1, 0, 1);
const gaokao2027 = new Date("2027-06-07T00:00:00+08:00");

const daysLeft = (targetDate: Date) =>
	Math.max(0, Math.ceil((targetDate.getTime() - Date.now()) / (1000 * 60 * 60 * 24)));

const countdownItems = [
	{ label: "距离月末还有", days: daysLeft(monthEnd), suffix: "天" },
	{ label: "距离下一年还有", days: daysLeft(nextYear), suffix: "天" },
	{ label: "距离2027年高考还有", days: daysLeft(gaokao2027), suffix: "天" },
];

const homepageTags = [...new Set(allPostsByDate.flatMap((p) => p.data.tags))].slice(0, 20);

const rightNavLinks = menuLinks.flatMap((item) =>
	item.children?.length ? item.children : item.path ? [item] : [],
);

const playlist = [
	{
		title: "Nujabes - Aruarian Dance",
		src: "https://cdn.pixabay.com/download/audio/2022/03/15/audio_c8e4b4fe5f.mp3?filename=lofi-study-112191.mp3",
	},
	{
		title: "Lo-Fi Night",
		src: "https://cdn.pixabay.com/download/audio/2021/08/04/audio_bb630cc098.mp3?filename=lofi-chill-medium-version-159456.mp3",
	},
	{
		title: "Rain + Piano",
		src: "https://cdn.pixabay.com/download/audio/2022/10/25/audio_eb891b3f95.mp3?filename=rain-and-piano-124841.mp3",
	},
];
---

<PageLayout meta={{ title: "Home" }}>
	<section class="grid gap-6 lg:grid-cols-[1.4fr_1fr]">
		<div class="space-y-6">
			<section class="rounded-md border border-zinc-200 bg-global-bg/80 p-5 dark:border-zinc-800">
				<h1 class="title mb-3" id="home-typing"></h1>
				<p id="home-location">欢迎来自远方的朋友~</p>
			</section>

			<section class="rounded-md border border-zinc-200 bg-global-bg/80 p-5 dark:border-zinc-800">
				<h2 class="title mb-4 text-xl">倒计时</h2>
				<ul class="space-y-3">
					{countdownItems.map((item) => (
						<li class="flex items-center justify-between rounded-md bg-zinc-100/70 px-3 py-2 dark:bg-zinc-900/70">
							<span>{item.label}</span>
							<strong>
								{item.days}
								{item.suffix}
							</strong>
						</li>
					))}
				</ul>
			</section>

			<section class="rounded-md border border-zinc-200 bg-global-bg/80 p-5 dark:border-zinc-800">
				<h2 class="title mb-4 text-xl">音乐播放器</h2>
				<div class="flex flex-col gap-3">
					<select id="playlist-select" class="rounded-md border border-zinc-300 bg-transparent px-3 py-2 dark:border-zinc-700">
						{playlist.map((song, index) => (
							<option value={song.src} data-title={song.title} selected={index === 0}>
								{song.title}
							</option>
						))}
					</select>
					<audio id="home-audio" controls class="w-full" src={playlist[0]?.src}></audio>
				</div>
			</section>
		</div>

		<div class="space-y-6">
			<section class="rounded-md border border-zinc-200 bg-global-bg/80 p-4 dark:border-zinc-800">
				<img
					alt="homepage cover"
					class="mb-3 h-44 w-full rounded-md object-cover"
					src="https://images.unsplash.com/photo-1510915228340-29c85a43dcfe?auto=format&fit=crop&w=1200&q=80"
				/>
				<p class="text-sm text-zinc-600 dark:text-zinc-400">上次更新 {latestUpdateDays} days ago</p>
			</section>

			<section class="rounded-md border border-zinc-200 bg-global-bg/80 p-5 dark:border-zinc-800">
				<h2 class="title mb-4 text-xl">导航</h2>
				<div class="mb-3">
					<Search />
				</div>
				<nav class="flex flex-col gap-2" aria-label="Home quick links">
					{rightNavLinks.map((link) => (
						<a
							class="rounded-md border border-zinc-200 px-3 py-2 hover:border-sky-300 hover:bg-sky-50/60 dark:border-zinc-700 dark:hover:border-sky-800 dark:hover:bg-sky-900/30"
							href={link.path}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noreferrer" : undefined}
						>
							{link.title}
						</a>
					))}
				</nav>
			</section>

			{
				homepageTags.length > 0 && (
					<section class="rounded-md border border-zinc-200 bg-global-bg/80 p-5 dark:border-zinc-800">
						<h2 class="title mb-4 text-xl">Tags</h2>
						<div class="flex flex-wrap gap-2">
							{homepageTags.map((tag) => (
								<a class="cactus-link" href={`/tags/${tag}/`}>
									#{tag}
								</a>
							))}
						</div>
					</section>
				)
			}
		</div>
	</section>
</PageLayout>

<script is:inline>
	const initHomeHero = () => {
		const typingTarget = document.getElementById("home-typing");
		const typingText = "幸せのカウントダウン";
		let idx = 0;
		let deleting = false;
		if (window.__homeTypingTimer) clearInterval(window.__homeTypingTimer);
		window.__homeTypingTimer = setInterval(() => {
			if (!typingTarget) return;
			typingTarget.textContent = typingText.slice(0, idx);
			if (!deleting) {
				idx += 1;
				if (idx > typingText.length) {
					deleting = true;
					idx = typingText.length;
				}
			} else {
				idx -= 1;
				if (idx < 1) {
					deleting = false;
					idx = 1;
				}
			}
		}, 120);

		const locationTarget = document.getElementById("home-location");
		fetch("https://ipapi.co/json/")
			.then((res) => res.json())
			.then((data) => {
				const cn = data?.country_name === "China";
				const locationName = cn
					? [data?.region, data?.city].filter(Boolean).join(" ") || "中国"
					: data?.country_name || "远方";
				if (locationTarget) locationTarget.textContent = `欢迎来自${locationName}的朋友~`;
			})
			.catch(() => {
				if (locationTarget) locationTarget.textContent = "欢迎来自远方的朋友~";
			});

		const player = document.getElementById("home-audio");
		const playlistSelect = document.getElementById("playlist-select");
		if (player instanceof HTMLAudioElement && playlistSelect instanceof HTMLSelectElement) {
			if (playlistSelect.dataset.bound !== "1") {
				playlistSelect.dataset.bound = "1";
				playlistSelect.addEventListener("change", () => {
					player.src = playlistSelect.value;
					player.play().catch(() => {});
				});
			}
		}
	};
	document.addEventListener("astro:page-load", initHomeHero);
	initHomeHero();
</script>
