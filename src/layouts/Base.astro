---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { ViewTransitions } from 'astro:transitions';  // 新增
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
} = Astro.props;
---

<html lang={siteConfig.lang}>
	<head>
        <BaseHead
			articleDate={articleDate}
			description={description}
			ogImage={ogImage}
			title={title}
		/>
		<ViewTransitions />
  	</head>
	<body class="site-shell">
    <div id="my-banner"></div>
		<Header />
		<main class="page-fade" id="main"><slot /></main>
		<Footer />
</html>

<script src="https://keepandroidopen.org/banner.js?link=https://keepandroidopen.org/&hidebutton=off&id=my-banner"></script>
<script>
	// 确保页面切换时只替换 main 区域，避免重复渲染 header/footer
	document.addEventListener('astro:before-swap', (e) => {
		const newMain = e.newDocument.querySelector('#main');
		const oldMain = document.querySelector('#main');
		if (newMain && oldMain) {
			oldMain.innerHTML = newMain.innerHTML;
			e.preventDefault(); // 阻止默认的全量替换
		}
	});

	document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.sitecard');
    
    // 1. 先用 IntersectionObserver 监听滚动触发
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.15 });

    cards.forEach((card, index) => {
      card.style.transitionDelay = `${index * 0.1}s`;
      observer.observe(card);
    });

    // 2. 页面加载后立即手动检查：已经在视口内的卡片马上浮现
    requestAnimationFrame(() => {
      const windowHeight = window.innerHeight;
      cards.forEach(card => {
        const rect = card.getBoundingClientRect();
        // 只要卡片顶部在视口内（或卡片底部已经进入视口）
        if (rect.top < windowHeight && rect.bottom > 0) {
          card.classList.add('visible');
        }
      });
    });
  });  
</script>
